{
  "name": "laboura-web",
  "version": "0.1.0",
  "private": true,
  "description": "Laboura staff portals and public pages \u2014 one React app served by Nest at /app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
