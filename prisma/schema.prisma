datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model JobSeeker {
  id                        String      @id @default(uuid())
  code                      String      @unique
  city                      String      @default("Bengaluru")
  name                      String
  phone                     String      @unique
  phoneVerified             Boolean     @default(false)
  tradeSkill                String
  minSalary                 Int         // paise
  maxSalary                 Int         // paise
  preferredCallWindowStart  String      // "09:00" IST
  preferredCallWindowEnd    String      // "21:00" IST
  status                    String      @default("pending_activation") // pending_activation, active, deactivated, placed
  hitCount                  Int         @default(0)
  kycStatus                 String      @default("pending") // pending, verified, failed
  kycReference              String?     // vendor reference ID only. NEVER raw national ID numbers.
  referredById              String?
  referredBy                Referral?   @relation(fields: [referredById], references: [id], onDelete: SetNull)
  paymentReceivedAt         DateTime?   // when the ₹499 activation fee was received
  placements                Placement[]
  payments                  Payment[]
  contactAttempts           ContactAttempt[]
  hits                      JobSeekerHit[]
  replacementCandidateOffers ReplacementCandidate[]
  callbackTasks             CallbackTask[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@index([city])
  @@index([tradeSkill])
  @@index([status])
}

model Referral {
  id            String      @id @default(uuid())
  code          String      @unique
  city          String      @default("Bengaluru")
  name          String
  phone         String      @unique
  phoneVerified Boolean     @default(false)
  type          String      @default("individual") // individual, business
  jobSeekers    JobSeeker[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([city])
}

model Business {
  id            String          @id @default(uuid())
  code          String          @unique
  city          String          @default("Bengaluru")
  name          String
  address       String?
  contactName   String?
  phone         String          @unique
  phoneVerified Boolean         @default(false)
  area          String
  gstNumber     String?
  latitude      Float?
  longitude     Float?
  geofenceFlag  Boolean         @default(false)
  selfieUrl     String?
  selfieHash    String?
  vacancies     Vacancy[]
  placements    Placement[]
  payments      Payment[]
  visits        BusinessVisit[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([city, area])
}

model Vacancy {
  id                          String      @id @default(uuid())
  code                        String      @unique
  city                        String      @default("Bengaluru")
  businessId                  String
  business                    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capturedByStaffId           String?
  capturedBy                  Staff?      @relation(fields: [capturedByStaffId], references: [id], onDelete: SetNull)
  replacementForPlacementId   String?     // null for fresh vacancies; links to dropped-out placement if replacement
  replacementForPlacement     Placement?  @relation("ReplacementPlacementVacancies", fields: [replacementForPlacementId], references: [id], onDelete: SetNull)
  tradeSkill                  String
  offeredSalary               Int         // paise
  headcount                   Int         @default(1)
  description                 String?
  status                      String      @default("open") // open, filled, cancelled
  placements                  Placement[]
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@index([city])
  @@index([businessId])
  @@index([replacementForPlacementId])
  @@index([tradeSkill])
  @@index([status])
}

model Placement {
  id                         String      @id @default(uuid())
  code                       String      @unique
  city                       String      @default("Bengaluru")
  vacancyId                  String
  vacancy                    Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  jobSeekerId                String
  jobSeeker                  JobSeeker   @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  businessId                 String
  business                   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  agreedSalary               Int         @default(0) // paise
  placementFee               Int         // paise
  gstAmount                  Int         // paise
  invoiceCode                String?     @unique
  joinedDate                 DateTime?
  dropoutReportedAt          DateTime?
  eligibility                String?     // employee_left, business_breach
  clockPaused                Boolean     @default(false)
  clockPausedAt              DateTime?
  status                     String      @default("offered") // offered, confirmed, rejected, active, dropped_out, replaced, completed
  replacementRejectionCount  Int         @default(0)
  replacementVacancies       Vacancy[]   @relation("ReplacementPlacementVacancies")
  replacementCandidates      ReplacementCandidate[]
  payments                   Payment[]
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([city])
  @@index([vacancyId])
  @@index([jobSeekerId])
  @@index([businessId])
  @@index([status])
}

model ReplacementCandidate {
  id              String     @id @default(uuid())
  placementId     String
  placement       Placement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  jobSeekerId     String
  jobSeeker       JobSeeker  @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  status          String     @default("offered") // offered, rejected, accepted
  rejectionReason String?
  offeredAt       DateTime   @default(now())
  rejectedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([placementId])
  @@index([jobSeekerId])
}

model Staff {
  id                String           @id @default(uuid())
  code              String           @unique
  city              String           @default("Bengaluru")
  name              String
  email             String           @unique
  passwordHash      String
  role              String           // ceo, manager, team_lead, call_agent, field_agent, finance
  teamLeadId        String?
  teamLead          Staff?           @relation("TeamHierarchy", fields: [teamLeadId], references: [id], onDelete: SetNull)
  teamMembers       Staff[]          @relation("TeamHierarchy")
  area              String?
  capturedVacancies Vacancy[]
  businessVisits    BusinessVisit[]
  auditLogs         AuditLog[]
  contactAttempts   ContactAttempt[]
  callbackTasks     CallbackTask[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([city])
  @@index([role])
  @@index([teamLeadId])
}

model Payment {
  id                String      @id @default(uuid())
  code              String      @unique
  city              String      @default("Bengaluru")
  type              String      // activation, placement_fee, referral_payout, refund
  amount            Int         // paise
  status            String      @default("pending") // pending, completed, failed, refunded
  gatewayReference  String      @unique
  subjectType       String      // job_seeker, business, referral, placement
  subjectId         String
  jobSeekerId       String?
  jobSeeker         JobSeeker?  @relation(fields: [jobSeekerId], references: [id], onDelete: SetNull)
  businessId        String?
  business          Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  referralId        String?
  referral          Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  placementId       String?
  placement         Placement?  @relation(fields: [placementId], references: [id], onDelete: SetNull)
  reactivation      Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([subjectType, subjectId])
}

model AuditLog {
  id          String    @id @default(uuid())
  code        String    @unique
  city        String    @default("Bengaluru")
  actorId     String
  actor       Staff?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityCode  String
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([city])
  @@index([actorId])
  @@index([entityType, entityCode])
  @@index([createdAt])
}

model ContactAttempt {
  id           String        @id @default(uuid())
  jobSeekerId  String
  jobSeeker    JobSeeker     @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  channel      String        // call, whatsapp, sms
  outcome      String        // picked_up, no_pickup
  attemptedAt  DateTime      // stored in UTC
  timeOfDay    String        // am, pm
  hitId        String?
  hit          JobSeekerHit? @relation(fields: [hitId], references: [id], onDelete: SetNull)
  staffId      String?
  staff        Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([jobSeekerId])
  @@index([hitId])
  @@index([attemptedAt])
}

model JobSeekerHit {
  id              String           @id @default(uuid())
  jobSeekerId     String
  jobSeeker       JobSeeker        @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  reason          String           // no_pickup, offer_rejected, interview_no_show
  note            String?
  recordedBy      String           // staffId or "system"
  recordedAt      DateTime         @default(now())
  contactAttempts ContactAttempt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([jobSeekerId])
  @@index([recordedAt])
}

model BusinessVisit {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId      String?
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  latitude     Float
  longitude    Float
  selfieUrl    String?
  selfieHash   String?
  geofenceFlag Boolean   @default(false)
  visitedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([businessId])
  @@index([selfieHash])
}

model CallbackTask {
  id                String      @id @default(uuid())
  callId            String      @unique
  phone             String
  callerName        String?
  virtualNumber     String      @default("18001234567")
  jobSeekerId       String?
  jobSeeker         JobSeeker?  @relation(fields: [jobSeekerId], references: [id], onDelete: SetNull)
  status            String      @default("pending") // pending, assigned, completed
  assignedToStaffId String?
  assignedToStaff   Staff?      @relation(fields: [assignedToStaffId], references: [id], onDelete: SetNull)
  recordingUrl      String?
  recordingConsent  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}


