datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicLinkPurpose {
  registration
  payment_only
  referral_registration
  business_agreement
  interview_owner_result
  interview_candidate_result
  offer_reply
  payout_details
  vacancy_confirm
}

model PublicLink {
  id                  String            @id @default(uuid())
  tokenHash           String            @unique
  purpose             PublicLinkPurpose
  subjectType         String
  subjectId           String
  phone               String?
  language            String?
  expiresAt           DateTime
  usedAt              DateTime?
  revokedAt           DateTime?
  openedAt            DateTime?
  completedUserAgent  String?
  completedIpHash     String?
  createdByStaffId    String?
  metadata            Json?
  createdAt           DateTime          @default(now())

  @@index([purpose, subjectType, subjectId, usedAt, revokedAt, expiresAt])
  @@index([expiresAt])
}

model OtpSession {
  id             String   @id @default(uuid())
  requestId      String   @unique
  phoneHash      String
  phoneEncrypted String
  purpose        String   @default("job_seeker")
  verified       Boolean  @default(false)
  attempts       Int      @default(0)
  resendCount    Int      @default(0)
  lastSentAt     DateTime
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

generator client {
  provider = "prisma-client-js"
}

model JobSeeker {
  id                        String      @id @default(uuid())
  code                      String      @unique
  city                      String      @default("Bengaluru")
  name                      String
  phone                     String      @unique
  phoneVerified             Boolean     @default(false)
  minSalary                 Int         // paise
  maxSalary                 Int         // paise
  preferredCallWindowStart  String      // "09:00" IST
  preferredCallWindowEnd    String      // "21:00" IST
  status                    String      @default("lead") // lead, consented, pending_activation, active, paused, deactivated, placed
  hitCount                  Int         @default(0)
  referredById              String?
  referredBy                Referral?   @relation(fields: [referredById], references: [id], onDelete: SetNull)
  registeredByStaffId       String?
  registeredBy              Staff?      @relation("JobSeekerRegisteredBy", fields: [registeredByStaffId], references: [id], onDelete: SetNull)
  paymentReceivedAt         DateTime?   // when the ₹499 activation fee was received
  guaranteeFloorPaise       Int?        // frozen salary guarantee term once activation is paid
  messageLanguage           String?
  heardFrom                 String?
  placements                Placement[]
  interviews                Interview[]
  candidateIntroductions    CandidateIntroduction[]
  payments                  Payment[]
  contactAttempts           ContactAttempt[]
  hits                      JobSeekerHit[]
  trades                    JobSeekerTrade[]
  languages                 JobSeekerLanguage[]
  identityVerifications     IdentityVerification[]
  kycRecoveryRequests      KycRecoveryRequest[]
  replacementCandidateOffers ReplacementCandidate[]
  callbackTasks             CallbackTask[]
  anonymisedAt              DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  // Phase 12 profile fields (data-design §4)
  dateOfBirth               DateTime?   @db.Date
  gender                    String?
  whatsappPhone             String?
  photoStoragePath          String?
  photoTakenAt              DateTime?
  locality                  String?
  pincode                   String?
  latitude                  Float?
  longitude                 Float?
  travelDistanceKm          Int?
  preferredLocalities       String[]    @default([])
  willingToRelocate         Boolean?
  needsAccommodation        Boolean?
  salaryPeriod              String?     // monthly, daily
  availableFrom             DateTime?   @db.Date
  lookingSince              DateTime?   @db.Date
  shiftPreference           String?     // day, night, rotational, any
  jobType                   String?     // full_time, part_time, live_in
  currentlyWorking          Boolean?
  lastEmployer              String?
  lastRole                  String?
  lastSalaryPaise           Int?
  educationLevel            String?
  certificates              String[]    @default([])
  drivingLicenceType        String?
  ownVehicle                Boolean?
  policeVerified            Boolean?
  hasSmartphone             Boolean?
  cvStoragePath             String?
  keySkills                 String[]    @default([])
  qualification             String?
  currentSalaryPaise        Int?
  pausedAt                  DateTime?

  @@index([city])
  @@index([status])
  @@index([status, paymentReceivedAt])
  @@index([registeredByStaffId])
}

model JobSeekerTrade {
  id              String    @id @default(uuid())
  jobSeekerId     String
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  trade           String
  yearsExperience Int       @default(0)
  isPrimary       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([jobSeekerId, trade])
  @@index([jobSeekerId])
}

model Trade {
  id                         String   @id @default(uuid())
  name                       String
  nameKey                    String   @unique
  salaryMinPaise             Int
  salaryMaxPaise             Int
  minimumWageLevel           String   @default("unskilled")
  active                     Boolean  @default(true)
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  mappedSuggestions          TradeSuggestion[] @relation("TradeSuggestionMapped")

  @@index([active, sortOrder])
}

model TradeSuggestion {
  id                String   @id @default(uuid())
  typedName         String
  typedNameKey      String   @unique
  typedByStaffId    String?
  subjectType       String
  subjectId         String
  status            String   @default("waiting")
  mappedToTradeId   String?
  mappedToTrade     Trade?   @relation("TradeSuggestionMapped", fields: [mappedToTradeId], references: [id], onDelete: SetNull)
  decidedByStaffId  String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
  subjects          TradeSuggestionSubject[]

  @@index([status, createdAt])
}

model TradeSuggestionSubject {
  id                 String          @id @default(uuid())
  tradeSuggestionId  String
  tradeSuggestion    TradeSuggestion @relation(fields: [tradeSuggestionId], references: [id], onDelete: Cascade)
  subjectType        String
  subjectId          String
  createdAt          DateTime        @default(now())

  @@unique([tradeSuggestionId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model JobSeekerLanguage {
  id          String    @id @default(uuid())
  jobSeekerId String
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  language    String
  speaks      Boolean   @default(false)
  reads       Boolean   @default(false)
  writes      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobSeekerId, language])
  @@index([jobSeekerId])
}

model IdentityVerification {
  id              String    @id @default(uuid())
  jobSeekerId     String
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  method          String    // digilocker, aadhaar_qr, pan, driving_licence, voter_id
  vendor          String
  vendorReference String
  status          String    // pending, verified, failed
  last4           String?   // last 4 digits only
  nameMatches     Boolean?
  isAdult         Boolean?
  verifiedAt      DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jobSeekerId])
  @@index([status])
}

model KycServiceState {
  id            String   @id @default("id-check")
  status        String   @default("up") // up, down
  lastChangedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KycRecoveryRequest {
  id             String   @id @default(uuid())
  jobSeekerId    String
  jobSeeker      JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  status         String   @default("waiting") // waiting, notifying, notified
  registrationLinkId String?
  requestedAt    DateTime @default(now())
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([jobSeekerId, status])
}

model Referral {
  id            String      @id @default(uuid())
  code          String      @unique
  city          String      @default("Bengaluru")
  name          String
  phone         String      @unique
  phoneVerified Boolean     @default(false)
  type          String      @default("individual") // individual, business
  jobSeekers    JobSeeker[]
  payments      Payment[]
  anonymisedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([city])
}

model Business {
  id            String          @id @default(uuid())
  code          String          @unique
  city          String          @default("Bengaluru")
  name          String
  address       String?
  phone         String          @unique
  phoneVerified Boolean         @default(false)
  gstNumber     String?
  latitude      Float?
  longitude     Float?
  geofenceFlag  Boolean         @default(false)
  legalName                String?
  ownerName                String?
  additionalContactName    String?
  additionalContactPhone   String?
  businessType             String?
  employeeCount            Int?
  staffNeeded              String[]  @default([])
  licenceNumber            String?
  shopEstablishmentNumber  String?
  udyamNumber              String?
  pan                      String?
  gstVerified              Boolean?
  gstLegalName             String?
  gstStatus                String?
  gstCheckedAt             DateTime?
  yearsInOperation         Int?
  hiringFrequency          String?
  billingName              String?
  billingAddress           String?
  storefrontPhotoPath      String?
  storefrontPhotoHash      String?
  storefrontPhotoLive      Boolean?
  documentsStatus          String?
  verificationStatus       String?   @default("lead")
  verifiedAt               DateTime?
  verifiedByStaffId        String?
  accountAgentId           String?
  accountAgentAssignedAt   DateTime?
  leadCreatedByStaffId     String?
  leadChannel              String?
  locality                 String?
  vacancies     Vacancy[]
  placements    Placement[]
  payments      Payment[]
  visits        BusinessVisit[]
  visitAssignments VisitAssignment[]
  agreements    BusinessAgreement[]
  candidateIntroductions CandidateIntroduction[]
  candidateIntroductionLinks CandidateIntroductionLink[]
  interviews                Interview[]
  followUpAnswerBusinesses  FollowUpTask[] @relation("FollowUpAnswerBusiness")
  anonymisedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([city])
  @@index([accountAgentId])
  @@index([verificationStatus])
}

model Vacancy {
  id                          String      @id @default(uuid())
  code                        String      @unique
  city                        String      @default("Bengaluru")
  businessId                  String
  business                    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capturedByStaffId           String?
  capturedBy                  Staff?      @relation(fields: [capturedByStaffId], references: [id], onDelete: SetNull)
  replacementForPlacementId   String?     // null for fresh vacancies; links to dropped-out placement if replacement
  replacementForPlacement     Placement?  @relation("ReplacementPlacementVacancies", fields: [replacementForPlacementId], references: [id], onDelete: SetNull)
  tradeSkill                  String
  headcount                   Int         @default(1)
  description                 String?
  status                      String      @default("open") // open, filled, cancelled
  roleTitle                   String?
  salaryMinPaise              Int?
  salaryMaxPaise              Int?
  salaryPeriod                String?
  extras                      String[]    @default([])
  workingHours                String?
  shift                       String?
  weeklyOff                   String?
  latitude                    Float?
  longitude                   Float?
  locality                    String?
  experienceRequiredYears     Int?
  educationRequired           String?
  languagesRequired           String[]    @default([])
  licencesRequired            String[]    @default([])
  ageMin                      Int?
  ageMax                      Int?
  genderRequirement           String?
  genderReason                String?
  startDate                   DateTime?   @db.Date
  urgency                     String?
  probationDays               Int?
  interviewType               String?
  interviewContactName        String?
  capturedChannel             String?
  interviewSlots              VacancyInterviewSlot[]
  interviews                  Interview[]
  placements                  Placement[]
  candidateIntroductions     CandidateIntroduction[]
  candidateIntroductionLinks CandidateIntroductionLink[]
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@index([city])
  @@index([businessId])
  @@index([replacementForPlacementId])
  @@index([tradeSkill])
  @@index([status])
}

model VacancyInterviewSlot {
  id        String   @id @default(uuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int?
  interviews Interview[]
  createdAt DateTime @default(now())

  @@index([vacancyId, startsAt])
}

model Interview {
  id                       String                @id @default(uuid())
  code                     String                @unique
  vacancyId                String
  vacancy                  Vacancy               @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  businessId               String
  business                 Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  jobSeekerId              String
  jobSeeker                JobSeeker             @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  vacancyInterviewSlotId   String
  vacancyInterviewSlot     VacancyInterviewSlot @relation(fields: [vacancyInterviewSlotId], references: [id], onDelete: Restrict)
  slotStartsAt             DateTime
  slotEndsAt               DateTime
  proposedByStaffId        String
  proposedBy               Staff                 @relation("InterviewProposedBy", fields: [proposedByStaffId], references: [id], onDelete: Restrict)
  proposedAt               DateTime              @default(now())
  suitabilitySnapshot      Json
  status                   String                @default("offered") // offered, confirmed, declined, no_reply, completed, no_show, cancelled, no_result
  offerMessageLogIds       String[]              @default([])
  offerSentAt              DateTime
  replyDueAt               DateTime
  candidateRespondedAt     DateTime?
  callRecordId             String?               @unique
  callRecord               CallRecord?           @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  businessDetailsSentAt    DateTime?
  agentAttendanceRequired  Boolean               @default(false)
  attendanceVisitId        String?
  result                   String?
  resultReason             String?
  resultOtpRequestId       String?
  resultDueAt              DateTime
  resultRequestSentAt      DateTime?
  resultRecordedAt         DateTime?
  selectedSalaryPaise      Int?
  selectedJoiningDate      DateTime?
  candidateCheckAnswer     String?
  candidateCheckAt         DateTime?
  cancelReason             String?
  placement                Placement?
  replacementCandidates    ReplacementCandidate[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([vacancyId, status])
  @@index([businessId, jobSeekerId, status])
  @@index([jobSeekerId, status])
  @@index([vacancyInterviewSlotId, status])
  @@index([replyDueAt, status])
  @@index([resultDueAt, status])
}

model Placement {
  id                         String      @id @default(uuid())
  code                       String      @unique
  city                       String      @default("Bengaluru")
  vacancyId                  String
  vacancy                    Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  jobSeekerId                String
  jobSeeker                  JobSeeker   @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  businessId                 String
  business                   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  interviewId                String?     @unique
  interview                  Interview?  @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  selectedAt                 DateTime?
  paymentDueAt               DateTime?
  paidAt                     DateTime?
  joiningDate                DateTime?
  joiningWorkerCallId        String?
  joiningWorkerCall          CallRecord? @relation("PlacementJoiningWorkerCall", fields: [joiningWorkerCallId], references: [id], onDelete: SetNull)
  joiningBusinessCallId      String?
  joiningBusinessCall        CallRecord? @relation("PlacementJoiningBusinessCall", fields: [joiningBusinessCallId], references: [id], onDelete: SetNull)
  rootPlacementId            String?
  replacementNumber          Int         @default(0)
  feePercentAtCreation       Int?
  gstPercentAtCreation       Int?
  guaranteeEndedReason       String?
  createdByStaffId           String?
  createdBy                  Staff?      @relation("PlacementCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  agreedSalary               Int         @default(0) // paise
  placementFee               Int         // paise
  gstAmount                  Int         // paise
  invoiceCode                String?     @unique
  joinedDate                 DateTime?
  dropoutReportedAt          DateTime?
  dropoutDateCallerSupplied  Boolean     @default(false)
  status                     String      @default("awaiting_payment") // awaiting_payment, cancelled, confirmed, active, dropped_out, replaced, completed, guarantee_ended; legacy statuses remain readable
  replacementVacancies       Vacancy[]   @relation("ReplacementPlacementVacancies")
  replacementCandidates      ReplacementCandidate[]
  replacementClaims          ReplacementClaim[]
  payments                   Payment[]
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([city])
  @@index([vacancyId])
  @@index([jobSeekerId])
  @@index([businessId])
  @@index([status])
  @@index([createdByStaffId])
  @@index([joiningWorkerCallId])
  @@index([joiningBusinessCallId])
}

model ReplacementCandidate {
  id              String     @id @default(uuid())
  placementId     String
  placement       Placement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  jobSeekerId     String
  jobSeeker       JobSeeker  @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  interviewId     String?
  interview       Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  status          String     @default("offered") // offered, rejected, accepted
  rejectionReason String?
  offeredAt       DateTime   @default(now())
  rejectedAt      DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([placementId])
  @@index([jobSeekerId])
  @@index([interviewId])
}

model ReplacementClaim {
  id                     String      @id @default(uuid())
  code                   String      @unique
  placementId            String
  placement              Placement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  workerLeftOn           DateTime
  reportedAt             DateTime    @default(now())
  reportedWithinDeadline Boolean
  feePaidInFull          Boolean
  reason                 String
  evidencePaths          String[]    @default([])
  exitCallRecordId       String?
  exitCallRecord         CallRecord? @relation("ExitCallRecord", fields: [exitCallRecordId], references: [id], onDelete: SetNull)
  callRecordId           String
  callRecord             CallRecord  @relation("ClaimCallRecord", fields: [callRecordId], references: [id], onDelete: Restrict)
  decision               String?
  decisionReason         String?
  decidedByStaffId       String?
  decidedByStaff         Staff?      @relation("ClaimDecidedBy", fields: [decidedByStaffId], references: [id], onDelete: SetNull)
  decidedAt              DateTime?
  decisionDueAt          DateTime
  overruledByStaffId     String?
  overruledByStaff       Staff?      @relation("ClaimOverruledBy", fields: [overruledByStaffId], references: [id], onDelete: SetNull)
  overruleReason         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([placementId])
  @@index([decision])
  @@index([decisionDueAt])
  @@index([decidedByStaffId])
  @@index([overruledByStaffId])
  @@index([callRecordId])
  @@index([exitCallRecordId])
}

model Staff {
  id                String           @id @default(uuid())
  code              String           @unique
  city              String           @default("Bengaluru")
  name              String
  email             String?          @unique
  passwordHash      String
  role              String           // ceo, manager, team_lead, call_agent, field_agent, finance
  teamLeadId        String?
  teamLead          Staff?           @relation("TeamHierarchy", fields: [teamLeadId], references: [id], onDelete: SetNull)
  teamMembers       Staff[]          @relation("TeamHierarchy")
  /// AES-256-GCM ciphertext. Never selected into an API response.
  callRoutingPhone  String?
  worksFromOffice   Boolean          @default(false)
  failedLoginCount  Int              @default(0)
  lockedUntil       DateTime?
  lockedByStaffId   String?
  lockedByStaff     Staff?           @relation("StaffLockedBy", fields: [lockedByStaffId], references: [id], onDelete: SetNull)
  staffLocked       Staff[]          @relation("StaffLockedBy")
  lockedReason      String?
  capturedVacancies Vacancy[]
  registeredJobSeekers JobSeeker[]      @relation("JobSeekerRegisteredBy")
  candidateIntroductionsShown CandidateIntroduction[] @relation("CandidateIntroductionShownBy")
  createdPlacements    Placement[]      @relation("PlacementCreatedBy")
  interviewsProposed   Interview[]      @relation("InterviewProposedBy")
  businessVisits    BusinessVisit[]
  checkIns          FieldCheckIn[]
  suggestedVisitAssignments VisitAssignment[] @relation("VisitAssignmentSuggested")
  assignedVisitAssignments VisitAssignment[] @relation("VisitAssignmentAssigned")
  assignedVisitAssignmentsByMe VisitAssignment[] @relation("VisitAssignmentAssignedBy")
  auditLogs         AuditLog[]
  contactAttempts   ContactAttempt[]
  callbackTasks     CallbackTask[]
  targets           Target[]         @relation("StaffTargets")
  createdTargets    Target[]         @relation("CreatedTargets")
  updatedTargets    Target[]         @relation("UpdatedTargets")
  pricingPoliciesSet PricingPolicy[] @relation("PricingPolicySetBy")
  statusHistoriesChanged StatusHistory[] @relation("StatusHistoryChangedBy")
  reviewFlagsRaisedFor ReviewFlag[]    @relation("ReviewFlagRaisedFor")
  reviewFlagsResolvedBy ReviewFlag[]   @relation("ReviewFlagResolvedBy")
  devices           StaffDevice[]    @relation("StaffDeviceOwner")
  devicesApproved   StaffDevice[]    @relation("StaffDeviceApprovedBy")
  devicesRevoked    StaffDevice[]    @relation("StaffDeviceRevokedBy")
  officeNetworksAdded OfficeNetwork[] @relation("OfficeNetworkAddedBy")
  loginCodeRequests LoginCodeRequest[] @relation("LoginCodeSubject")
  loginCodesRevealed LoginCodeRequest[] @relation("LoginCodeRevealedBy")
  loginCodesRefused LoginCodeRequest[] @relation("LoginCodeRefusedBy")
  callRecords       CallRecord[]
  bankCreditsEntered BankCredit[]     @relation("BankCreditEnteredBy")
  reversedHits      JobSeekerHit[]   @relation("JobSeekerHitReversedBy")
  claimsDecided     ReplacementClaim[] @relation("ClaimDecidedBy")
  claimsOverruled   ReplacementClaim[] @relation("ClaimOverruledBy")
  assignedFollowUpTasks FollowUpTask[]
  totpSecret        String?
  totpEnabled       Boolean          @default(false)
  status            String           @default("active") // pending_invite, active, deactivated
  inviteTokenHash   String?          @unique // SHA-256 of the one-time invite token; the raw token is never stored
  inviteExpiresAt   DateTime?
  deactivatedAt     DateTime?
  sessions          StaffSession[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([city])
  @@index([role])
  @@index([teamLeadId])
  @@index([lockedByStaffId])
}

model Payment {
  id                String      @id @default(uuid())
  code              String      @unique
  city              String      @default("Bengaluru")
  type              String      // activation, placement_fee, referral_payout, refund, joining_reward
  amount            Int         // paise
  status            String      @default("pending") // pending, processing, succeeded, completed, failed, reversed, refunded
  gatewayReference  String?     @unique
  method            String      @default("upi_direct") // upi_direct, gateway_card
  upiReference      String?     @unique
  expectedAmountPaise Int?
  bankUtr           String?     @unique
  confirmedBy       String?     // bank_feed, finance_manual, gateway
  confirmedByStaffId String?
  confirmedAt       DateTime?
  approvedByStaffId String?
  approvedAt        DateTime?
  paidAt            DateTime?
  paidByStaffId     String?
  payoutAccountId   String?
  payoutAccount     PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  payerUtrHint      String?
  subjectType       String      // job_seeker, business, referral, placement
  subjectId         String
  jobSeekerId       String?
  jobSeeker         JobSeeker?  @relation(fields: [jobSeekerId], references: [id], onDelete: SetNull)
  businessId        String?
  business          Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  referralId        String?
  referral          Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  placementId       String?
  placement         Placement?  @relation(fields: [placementId], references: [id], onDelete: SetNull)
  bankCredit        BankCredit?
  reactivation      Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([subjectType, subjectId])
  @@index([jobSeekerId, type])
  @@index([placementId, type])
}

model BankCredit {
  id                String    @id @default(uuid())
  bankUtr           String    @unique
  amountPaise       Int
  receivedAt        DateTime
  payerName         String?
  payerVpaMasked    String?
  remark            String?
  source            String    // bank_feed, finance_manual
  enteredByStaffId  String?
  enteredByStaff    Staff?    @relation("BankCreditEnteredBy", fields: [enteredByStaffId], references: [id], onDelete: SetNull)
  status            String    @default("unmatched") // unmatched, matched, ignored
  matchedPaymentId  String?   @unique
  matchedPayment    Payment?  @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  ignoredReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// One row per payout-status webhook event already applied (AGENTS.md §2 rule 7).
// `eventId` is the gateway's x-razorpay-event-id, so a redelivery is a no-op.
model PayoutWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       String
  outcome     String
  paymentId   String?
