  businessId             String
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  version                String
  termsHash              String
  noBypassMonths         Int
  noBypassPenaltyPercent Int
  feePercent             Int
  gstPercent             Int
  signedName             String
  signedPhone            String
  otpRequestId           String
  signedAt               DateTime
  documentStoragePath    String
  createdAt              DateTime @default(now())

  @@index([businessId, signedAt])
}

model FollowUpTask {
  id               String      @id @default(uuid())
  code             String      @unique
  kind             String      // not_selected_day_7, not_selected_day_30, not_selected_day_90, placement_check_in_day_7, placement_check_in_day_30, refund_check, exit_call
  subjectType      String      // job_seeker, business
  subjectId        String
  relatedType      String?     // interview, placement, claim
  relatedId        String?
  dueAt            DateTime
  assignedStaffId  String?
  assignedStaff    Staff?      @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  status           String      @default("pending") // pending, done, missed
  callRecordId     String?
  callRecord       CallRecord? @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  answer           String?     // working_at_introduced_business, working_elsewhere, not_working, no_answer
  answerBusinessId String?
  answerBusiness   Business?   @relation("FollowUpAnswerBusiness", fields: [answerBusinessId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, dueAt])
  @@index([subjectType, subjectId])
  @@index([assignedStaffId])
  @@index([kind])
