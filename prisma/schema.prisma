// Supabase (see DEPLOY.md):
//   DATABASE_URL = transaction pooler, port 6543, with
//                  ?pgbouncer=true&connection_limit=5&sslmode=require
//                  (what the running app uses).
//   DIRECT_URL   = session pooler, port 5432, with ?sslmode=require
//                  (what `prisma migrate deploy` uses; the transaction pooler
//                  cannot run migrations).
// Locally and in CI both point at the same database.
//
// Every table in the public schema must have row level security enabled (no
// policies), so Supabase's automatic REST API cannot read it. Prisma connects
// as the table owner and is not affected. A migration that creates a table
// must also run: ALTER TABLE "NewTable" ENABLE ROW LEVEL SECURITY;
// src/common/prisma/row-level-security.spec.ts fails CI if one is missed.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublicLinkPurpose {
  registration
  payment_only
  referral_registration
  business_agreement
  interview_owner_result
  interview_candidate_result
  offer_reply
  payout_details
  vacancy_confirm
}

model PublicLink {
  id                  String            @id @default(uuid())
  tokenHash           String            @unique
  purpose             PublicLinkPurpose
  subjectType         String
  subjectId           String
  phone               String?
  language            String?
  expiresAt           DateTime
  usedAt              DateTime?
  revokedAt           DateTime?
  openedAt            DateTime?
  completedUserAgent  String?
  completedIpHash     String?
  createdByStaffId    String?
  metadata            Json?
  createdAt           DateTime          @default(now())

  @@index([purpose, subjectType, subjectId, usedAt, revokedAt, expiresAt])
  @@index([expiresAt])
}

/// One code sent from a public page (registration, payment-only, agreement, owner result, referral terms),
/// so the server can limit them per link and per phone (PublicOtpLimiter). Rows older than 24 hours are removed.
model PublicOtpSend {
  id        String   @id @default(uuid())
  linkKey   String
  phoneHash String
  sentAt    DateTime @default(now())

  @@index([linkKey, sentAt])
  @@index([phoneHash, sentAt])
}

model OtpSession {
  id             String   @id @default(uuid())
  requestId      String   @unique
  phoneHash      String
  phoneEncrypted String
  purpose        String   @default("job_seeker")
  verified       Boolean  @default(false)
  attempts       Int      @default(0)
  resendCount    Int      @default(0)
  lastSentAt     DateTime
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

generator client {
  provider = "prisma-client-js"
}

model JobSeeker {
  id                        String      @id @default(uuid())
  code                      String      @unique
  city                      String      @default("Bengaluru")
  name                      String
  phone                     String      @unique
  phoneVerified             Boolean     @default(false)
  minSalary                 Int         // paise
  maxSalary                 Int         // paise
  preferredCallWindowStart  String      // "09:00" IST
  preferredCallWindowEnd    String      // "21:00" IST
  status                    String      @default("lead") // lead, consented, pending_activation, active, paused, deactivated, placed, closed
  hitCount                  Int         @default(0)
  referredById              String?
  referredBy                Referral?   @relation(fields: [referredById], references: [id], onDelete: SetNull)
  registeredByStaffId       String?
  registeredBy              Staff?      @relation("JobSeekerRegisteredBy", fields: [registeredByStaffId], references: [id], onDelete: SetNull)
  paymentReceivedAt         DateTime?   // when the ₹499 activation fee was received
  guaranteeFloorPaise       Int?        // frozen salary guarantee term once activation is paid
  termsAcceptedAt           DateTime?   // when he ticked the exact terms on the registration link (Phase 20 Task 5)
  termsAcceptedFloorPaise   Int?        // the salary floor shown when he agreed
  messageLanguage           String?
  heardFrom                 String?
  placements                Placement[]
  interviews                Interview[]
  candidateIntroductions    CandidateIntroduction[]
  payments                  Payment[]
  contactAttempts           ContactAttempt[]
  hits                      JobSeekerHit[]
  trades                    JobSeekerTrade[]
  languages                 JobSeekerLanguage[]
  identityVerifications     IdentityVerification[]
  kycRecoveryRequests      KycRecoveryRequest[]
  replacementCandidateOffers ReplacementCandidate[]
  callbackTasks             CallbackTask[]
  anonymisedAt              DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  // Phase 12 profile fields (data-design §4)
  dateOfBirth               DateTime?   @db.Date
  gender                    String?
  whatsappPhone             String?
  photoStoragePath          String?
  photoTakenAt              DateTime?
  locality                  String?
  pincode                   String?
  latitude                  Float?
  longitude                 Float?
  travelDistanceKm          Int?
  preferredLocalities       String[]    @default([])
  willingToRelocate         Boolean?
  needsAccommodation        Boolean?
  salaryPeriod              String?     // monthly, daily
  availableFrom             DateTime?   @db.Date
  lookingSince              DateTime?   @db.Date
  shiftPreference           String?     // day, night, rotational, any
  jobType                   String?     // full_time, part_time, live_in
  currentlyWorking          Boolean?
  lastEmployer              String?
  lastRole                  String?
  lastSalaryPaise           Int?
  educationLevel            String?
  certificates              String[]    @default([])
  drivingLicenceType        String?
  ownVehicle                Boolean?
  policeVerified            Boolean?
  hasSmartphone             Boolean?
  cvStoragePath             String?
  keySkills                 String[]    @default([])
  qualification             String?
  currentSalaryPaise        Int?
  pausedAt                  DateTime?
  /// When staff recorded that he found a job on his own (not through Laboura).
  /// The profile is closed (status "closed") and the ₹499 refund is blocked.
  foundOwnJobAt             DateTime?

  @@index([city])
  @@index([status])
  @@index([status, paymentReceivedAt])
  @@index([registeredByStaffId])
}

model JobSeekerTrade {
  id              String    @id @default(uuid())
  jobSeekerId     String
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  trade           String
  yearsExperience Int       @default(0)
  isPrimary       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([jobSeekerId, trade])
  @@index([jobSeekerId])
}

model Trade {
  id                         String   @id @default(uuid())
  name                       String
  nameKey                    String   @unique
  salaryMinPaise             Int
  salaryMaxPaise             Int
  minimumWageLevel           String   @default("unskilled")
  active                     Boolean  @default(true)
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  mappedSuggestions          TradeSuggestion[] @relation("TradeSuggestionMapped")

  @@index([active, sortOrder])
}

model TradeSuggestion {
  id                String   @id @default(uuid())
  typedName         String
  typedNameKey      String   @unique
  typedByStaffId    String?
  subjectType       String
  subjectId         String
  status            String   @default("waiting")
  mappedToTradeId   String?
  mappedToTrade     Trade?   @relation("TradeSuggestionMapped", fields: [mappedToTradeId], references: [id], onDelete: SetNull)
  decidedByStaffId  String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
  subjects          TradeSuggestionSubject[]

  @@index([status, createdAt])
}

model TradeSuggestionSubject {
  id                 String          @id @default(uuid())
  tradeSuggestionId  String
  tradeSuggestion    TradeSuggestion @relation(fields: [tradeSuggestionId], references: [id], onDelete: Cascade)
  subjectType        String
  subjectId          String
  createdAt          DateTime        @default(now())

  @@unique([tradeSuggestionId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model JobSeekerLanguage {
  id          String    @id @default(uuid())
  jobSeekerId String
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  language    String
  speaks      Boolean   @default(false)
  reads       Boolean   @default(false)
  writes      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobSeekerId, language])
  @@index([jobSeekerId])
}

model IdentityVerification {
  id              String    @id @default(uuid())
  jobSeekerId     String
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  method          String    // digilocker, aadhaar_qr, pan, driving_licence, voter_id
  vendor          String
  vendorReference String
  status          String    // pending, verified, failed
  last4           String?   // last 4 digits only
  nameMatches     Boolean?
  isAdult         Boolean?
  verifiedAt      DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jobSeekerId])
  @@index([status])
}

model KycServiceState {
  id            String   @id @default("id-check")
  status        String   @default("up") // up, down
  lastChangedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KycRecoveryRequest {
  id             String   @id @default(uuid())
  jobSeekerId    String
  jobSeeker      JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  status         String   @default("waiting") // waiting, notifying, notified
  registrationLinkId String?
  requestedAt    DateTime @default(now())
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([jobSeekerId, status])
}

model Referral {
  id            String      @id @default(uuid())
  code          String      @unique
  city          String      @default("Bengaluru")
  name          String
  phone         String      @unique
  phoneVerified Boolean     @default(false)
  type          String      @default("individual") // individual, business
  whatsappPhone String?
  language      String?
  individualRole String?
  businessId    String?
  business      Business?   @relation("ReferralPartnerBusiness", fields: [businessId], references: [id], onDelete: SetNull)
  partnerBusinessType String?
  partnerBusinessName String?
  locality      String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  heardFrom     String?
  photoStoragePath String?
  photoTakenAt  DateTime?
  jobSeekers    JobSeeker[]
  payments      Payment[]
  identityVerifications ReferralIdentityVerification[]
  /// Paused by the CEO (guide, Referral partners): new referrals naming this
  /// partner are refused; money already earned is still paid. Unpause restores.
  pausedAt      DateTime?
  pausedByStaffId String?
  pauseReason   String?
  anonymisedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([city])
}

model Business {
  id            String          @id @default(uuid())
  code          String          @unique
  city          String          @default("Bengaluru")
  name          String
  address       String?
  phone         String          @unique
  phoneVerified Boolean         @default(false)
  gstNumber     String?
  latitude      Float?
  longitude     Float?
  geofenceFlag  Boolean         @default(false)
  legalName                String?
  ownerName                String?
  additionalContactName    String?
  additionalContactPhone   String?
  familyName               String?
  contactRole              String?
  contactWhatsAppPhone     String?
  contactLanguage          String?
  businessType             String?
  employeeCountBand        String?
  employeeCount            Int?
  staffNeeded              String[]  @default([])
  licenceNumber            String?
  shopEstablishmentNumber  String?
  udyamNumber              String?
  pan                      String?
  gstVerified              Boolean?
  gstLegalName             String?
  gstStatus                String?
  gstCheckedAt             DateTime?
  yearsInOperation         Int?
  yearsInOperationBand     String?
  hiringFrequency          String?
  openingTime              String?
  closingTime              String?
  workingDays              String[]  @default([])
  shopNumber               String?
  street                   String?
  landmark                 String?
  pincode                  String?
  billingName              String?
  billingAddress           String?
  billingEmail             String?
  heardFrom                String?
  fssaiNumber              String?
  storefrontPhotoPath      String?
  storefrontPhotoHash      String?
  storefrontPhotoLive      Boolean?
  documentsStatus          String?
  verificationStatus       String?   @default("lead")
  verifiedAt               DateTime?
  verifiedByStaffId        String?
  accountAgentId           String?
  accountAgentAssignedAt   DateTime?
  leadCreatedByStaffId     String?
  leadChannel              String?
  locality                 String?
  /// Set when the field agent who registered the business at the shop has
  /// the GPS-checked visit, the storefront photo and the agreement signed by
  /// OTP. Candidates and interviews are then allowed the same day, before the
  /// Team Lead's review (Master Guide, decided 9 Nov).
  inPersonOnboardedAt      DateTime?
  /// A Team Lead (or above) paused the business: no matching and no new
  /// interviews until it is unpaused.
  pausedAt                 DateTime?
  pausedByStaffId          String?
  pauseReason              String?
  branches      BusinessBranch[]
  vacancies     Vacancy[]
  placements    Placement[]
  payments      Payment[]
  visits        BusinessVisit[]
  visitAssignments VisitAssignment[]
  agreements    BusinessAgreement[]
  candidateIntroductions CandidateIntroduction[]
  candidateIntroductionLinks CandidateIntroductionLink[]
  interviews                Interview[]
  referralPartners          Referral[] @relation("ReferralPartnerBusiness")
  followUpAnswerBusinesses  FollowUpTask[] @relation("FollowUpAnswerBusiness")
  anonymisedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([city])
  @@index([accountAgentId])
  @@index([verificationStatus])
}

model BusinessBranch {
  id                   String    @id @default(uuid())
  businessId           String
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  shopNumber           String?
  street               String?
  landmark             String?
  address              String?
  locality             String?
  pincode              String?
  latitude             Float?
  longitude            Float?
  contactPersonName    String
  contactPersonRole    String
  contactPersonPhone   String
  contactWhatsAppPhone String?
  contactLanguage      String?
  vacancies            Vacancy[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([businessId])
  @@index([contactPersonPhone])
}

model ReferralIdentityVerification {
  id              String    @id @default(uuid())
  referralId      String
  referral        Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  method          String
  vendor          String
  vendorReference String
  status          String
  last4           String?
  nameMatches     Boolean?
  isAdult         Boolean?
  verifiedAt      DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([referralId, createdAt])
  @@index([status])
}

model Vacancy {
  id                          String      @id @default(uuid())
  code                        String      @unique
  city                        String      @default("Bengaluru")
  businessId                  String
  business                    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId                    String?
  branch                      BusinessBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  capturedByStaffId           String?
  capturedBy                  Staff?      @relation(fields: [capturedByStaffId], references: [id], onDelete: SetNull)
  replacementForPlacementId   String?     // null for fresh vacancies; links to dropped-out placement if replacement
  replacementForPlacement     Placement?  @relation("ReplacementPlacementVacancies", fields: [replacementForPlacementId], references: [id], onDelete: SetNull)
  tradeSkill                  String
  headcount                   Int         @default(1)
  description                 String?
  status                      String      @default("open") // open, filled, cancelled
  roleTitle                   String?
  salaryMinPaise              Int?
  salaryMaxPaise              Int?
  salaryPeriod                String?
  extras                      String[]    @default([])
  workingHours                String?
  shift                       String?
  weeklyOff                   String?
  latitude                    Float?
  longitude                   Float?
  locality                    String?
  experienceRequiredYears     Int?
  educationRequired           String?
  languagesRequired           String[]    @default([])
  licencesRequired            String[]    @default([])
  ageMin                      Int?
  ageMax                      Int?
  genderRequirement           String?
  genderReason                String?
  startDate                   DateTime?   @db.Date
  urgency                     String?
  probationDays               Int?
  interviewType               String?
  interviewContactName        String?
  capturedChannel             String?
  interviewSlots              VacancyInterviewSlot[]
  interviews                  Interview[]
  placements                  Placement[]
  candidateIntroductions     CandidateIntroduction[]
  candidateIntroductionLinks CandidateIntroductionLink[]
  ownerFavourites            OwnerFavourite[]
  /// Phase 20 Task 8: who confirmed the vacancy, when and how (code_on_call, code_on_visit, sms_link)
  confirmedAt                 DateTime?
  confirmationMethod          String?
  confirmedByName             String?
  confirmedByRole             String?
  confirmedPhoneLast4         String?
  confirmationRecordedByStaffId String?
  /// Legal minimum wage check (Phase 20 Task 8)
  belowLegalMinimum           Boolean     @default(false)
  ownerToldMinimumWage        Boolean     @default(false)
  legalMinimumPaise           Int?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@index([city])
  @@index([businessId])
  @@index([branchId])
  @@index([replacementForPlacementId])
  @@index([tradeSkill])
  @@index([belowLegalMinimum])
  @@index([status])
}

model VacancyInterviewSlot {
  id        String   @id @default(uuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int?
  interviews Interview[]
  createdAt DateTime @default(now())

  @@index([vacancyId, startsAt])
}

model Interview {
  id                       String                @id @default(uuid())
  code                     String                @unique
  vacancyId                String
  vacancy                  Vacancy               @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  businessId               String
  business                 Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  jobSeekerId              String
  jobSeeker                JobSeeker             @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  vacancyInterviewSlotId   String
  vacancyInterviewSlot     VacancyInterviewSlot @relation(fields: [vacancyInterviewSlotId], references: [id], onDelete: Restrict)
  slotStartsAt             DateTime
  slotEndsAt               DateTime
  proposedByStaffId        String
  proposedBy               Staff                 @relation("InterviewProposedBy", fields: [proposedByStaffId], references: [id], onDelete: Restrict)
  proposedAt               DateTime              @default(now())
  suitabilitySnapshot      Json
  status                   String                @default("offered") // offered, confirmed, declined, no_reply, completed, no_show, cancelled, no_result
  offerMessageLogIds       String[]              @default([])
  offerSentAt              DateTime
  replyDueAt               DateTime
  candidateRespondedAt     DateTime?
  callRecordId             String?               @unique
  callRecord               CallRecord?           @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  businessDetailsSentAt    DateTime?
  agentAttendanceRequired  Boolean               @default(false)
  attendanceVisitId        String?
  /// Interview day: the field agent marked "candidate arrived" at the shop, with GPS.
  candidateArrivedAt             DateTime?
  candidateArrivedByStaffId      String?
  candidateArrivedLatitude       Float?
  candidateArrivedLongitude      Float?
  candidateArrivedAccuracyMeters Float?
  candidateArrivedDistanceMeters Float?
  result                   String?
  resultReason             String?
  resultOtpRequestId       String?
  resultDueAt              DateTime
  resultRequestSentAt      DateTime?
  resultRecordedAt         DateTime?
  selectedSalaryPaise      Int?
  selectedJoiningDate      DateTime?
  candidateCheckAnswer     String?
  candidateCheckAt         DateTime?
  cancelReason             String?
  /// How the interview happens (guide, "Confirming in the shop", decided 9 Nov):
  /// in_shop_call (the phone talk in the shop is the first interview), at_shop,
  /// walk_in, or phone (Laboura calls both at the set time). Null on older bookings.
  interviewType            String?
  /// The field agent ticked "I will attend" when booking.
  agentWillAttend          Boolean               @default(false)
  /// In-shop confirmation: the agent handed his phone to the owner on the same recorded call.
  handedToOwnerAt          DateTime?
  /// The field agent who recorded the owner's decision in the shop (the owner confirmed it by OTP).
  resultRecordedByStaffId  String?
  /// Phone interview: when Laboura rang both sides, and the call record.
  phoneInterviewDialledAt  DateTime?
  phoneInterviewCallRecordId String?
  placement                Placement?
  replacementCandidates    ReplacementCandidate[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([vacancyId, status])
  @@index([businessId, jobSeekerId, status])
  @@index([jobSeekerId, status])
  @@index([vacancyInterviewSlotId, status])
  @@index([replyDueAt, status])
  @@index([resultDueAt, status])
}

model Placement {
  id                         String      @id @default(uuid())
  code                       String      @unique
  city                       String      @default("Bengaluru")
  vacancyId                  String
  vacancy                    Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  jobSeekerId                String
  jobSeeker                  JobSeeker   @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  businessId                 String
  business                   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  interviewId                String?     @unique
  interview                  Interview?  @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  selectedAt                 DateTime?
  paymentDueAt               DateTime?
  paidAt                     DateTime?
  joiningDate                DateTime?
  joiningWorkerCallId        String?
  joiningWorkerCall          CallRecord? @relation("PlacementJoiningWorkerCall", fields: [joiningWorkerCallId], references: [id], onDelete: SetNull)
  joiningBusinessCallId      String?
  joiningBusinessCall        CallRecord? @relation("PlacementJoiningBusinessCall", fields: [joiningBusinessCallId], references: [id], onDelete: SetNull)
  rootPlacementId            String?
  replacementNumber          Int         @default(0)
  feePercentAtCreation       Int?
  gstPercentAtCreation       Int?
  guaranteeEndedReason       String?
  createdByStaffId           String?
  createdBy                  Staff?      @relation("PlacementCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  agreedSalary               Int         @default(0) // paise
  placementFee               Int         // paise
  gstAmount                  Int         // paise
  invoiceCode                String?     @unique
  joinedDate                 DateTime?
  dropoutReportedAt          DateTime?
  dropoutDateCallerSupplied  Boolean     @default(false)
  /// FA11: the owner said on the joining call that the worker didn't come.
  joiningNoShowReportedAt    DateTime?
  /// FA11: how many times the owner moved the joining date on the joining call.
  joiningMovedCount          Int         @default(0)
  status                     String      @default("awaiting_payment") // awaiting_payment, cancelled, confirmed, active, dropped_out, replaced, completed, guarantee_ended; legacy statuses remain readable
  replacementVacancies       Vacancy[]   @relation("ReplacementPlacementVacancies")
  replacementCandidates      ReplacementCandidate[]
  replacementClaims          ReplacementClaim[]
  payments                   Payment[]
  tdsReceivables             TdsReceivable[]
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([city])
  @@index([vacancyId])
  @@index([jobSeekerId])
  @@index([businessId])
  @@index([status])
  @@index([createdByStaffId])
  @@index([joiningWorkerCallId])
  @@index([joiningBusinessCallId])
}

model ReplacementCandidate {
  id              String     @id @default(uuid())
  placementId     String
  placement       Placement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  jobSeekerId     String
  jobSeeker       JobSeeker  @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  interviewId     String?
  interview       Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  status          String     @default("offered") // offered, rejected, accepted
  rejectionReason String?
  offeredAt       DateTime   @default(now())
  rejectedAt      DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([placementId])
  @@index([jobSeekerId])
  @@index([interviewId])
}

model ReplacementClaim {
  id                     String      @id @default(uuid())
  code                   String      @unique
  placementId            String
  placement              Placement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  workerLeftOn           DateTime
  reportedAt             DateTime    @default(now())
  reportedWithinDeadline Boolean
  feePaidInFull          Boolean
  reason                 String
  evidencePaths          String[]    @default([])
  exitCallRecordId       String?
  exitCallRecord         CallRecord? @relation("ExitCallRecord", fields: [exitCallRecordId], references: [id], onDelete: SetNull)
  callRecordId           String
  callRecord             CallRecord  @relation("ClaimCallRecord", fields: [callRecordId], references: [id], onDelete: Restrict)
  decision               String?
  decisionReason         String?
  decidedByStaffId       String?
  decidedByStaff         Staff?      @relation("ClaimDecidedBy", fields: [decidedByStaffId], references: [id], onDelete: SetNull)
  decidedAt              DateTime?
  decisionDueAt          DateTime
  overruledByStaffId     String?
  overruledByStaff       Staff?      @relation("ClaimOverruledBy", fields: [overruledByStaffId], references: [id], onDelete: SetNull)
  overruleReason         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([placementId])
  @@index([decision])
  @@index([decisionDueAt])
  @@index([decidedByStaffId])
  @@index([overruledByStaffId])
  @@index([callRecordId])
  @@index([exitCallRecordId])
}

model Staff {
  id                String           @id @default(uuid())
  code              String           @unique
  city              String           @default("Bengaluru")
  name              String
  email             String?          @unique
  passwordHash      String
  role              String           // ceo, manager, team_lead, call_agent, field_agent, finance
  teamLeadId        String?
  teamLead          Staff?           @relation("TeamHierarchy", fields: [teamLeadId], references: [id], onDelete: SetNull)
  teamMembers       Staff[]          @relation("TeamHierarchy")
  /// Who this person reports to. Agents point at their Team Lead (kept in
  /// step with teamLeadId). A Team Lead points at a Manager. A Manager or
  /// Finance points at the CEO. The CEO points at nobody.
  reportsToId       String?
  reportsTo         Staff?           @relation("ReportingLine", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports     Staff[]          @relation("ReportingLine")
  /// AES-256-GCM ciphertext. Never selected into an API response.
  callRoutingPhone  String?
  worksFromOffice   Boolean          @default(false)
  /// A Team Lead's team name ("Team South"), set by the CEO on the Teams
  /// screen. Null for everyone else; a team is its Team Lead and their agents.
  teamName          String?
  /// An intern (call or field agent) — carries the same targets as paid agents.
  isIntern          Boolean          @default(false)
  /// Joining date, entered when the staff member is added (CEO or Manager);
  /// payroll counts from it.
  joinedOn          DateTime?        @db.Date
  failedLoginCount  Int              @default(0)
  lockedUntil       DateTime?
  lockedByStaffId   String?
  lockedByStaff     Staff?           @relation("StaffLockedBy", fields: [lockedByStaffId], references: [id], onDelete: SetNull)
  staffLocked       Staff[]          @relation("StaffLockedBy")
  lockedReason      String?
  capturedVacancies Vacancy[]
  registeredJobSeekers JobSeeker[]      @relation("JobSeekerRegisteredBy")
  candidateIntroductionsShown CandidateIntroduction[] @relation("CandidateIntroductionShownBy")
  createdPlacements    Placement[]      @relation("PlacementCreatedBy")
  interviewsProposed   Interview[]      @relation("InterviewProposedBy")
  businessVisits    BusinessVisit[]
  checkIns          FieldCheckIn[]
  suggestedVisitAssignments VisitAssignment[] @relation("VisitAssignmentSuggested")
  assignedVisitAssignments VisitAssignment[] @relation("VisitAssignmentAssigned")
  assignedVisitAssignmentsByMe VisitAssignment[] @relation("VisitAssignmentAssignedBy")
  auditLogs         AuditLog[]
  leaveAccruals     LeaveAccrual[]
  leaveRequests     LeaveRequest[]
  attendanceCorrections AttendanceCorrection[]
  contactAttempts   ContactAttempt[]
  callbackTasks     CallbackTask[]
  targets           Target[]         @relation("StaffTargets")
  createdTargets    Target[]         @relation("CreatedTargets")
  updatedTargets    Target[]         @relation("UpdatedTargets")
  pricingPoliciesSet PricingPolicy[] @relation("PricingPolicySetBy")
  statusHistoriesChanged StatusHistory[] @relation("StatusHistoryChangedBy")
  reviewFlagsRaisedFor ReviewFlag[]    @relation("ReviewFlagRaisedFor")
  reviewFlagsResolvedBy ReviewFlag[]   @relation("ReviewFlagResolvedBy")
  devices           StaffDevice[]    @relation("StaffDeviceOwner")
  devicesApproved   StaffDevice[]    @relation("StaffDeviceApprovedBy")
  devicesRevoked    StaffDevice[]    @relation("StaffDeviceRevokedBy")
  officeNetworksAdded OfficeNetwork[] @relation("OfficeNetworkAddedBy")
  loginCodeRequests LoginCodeRequest[] @relation("LoginCodeSubject")
  loginCodesRevealed LoginCodeRequest[] @relation("LoginCodeRevealedBy")
  loginCodesRefused LoginCodeRequest[] @relation("LoginCodeRefusedBy")
  callRecords       CallRecord[]
  bankCreditsEntered BankCredit[]     @relation("BankCreditEnteredBy")
  reversedHits      JobSeekerHit[]   @relation("JobSeekerHitReversedBy")
  claimsDecided     ReplacementClaim[] @relation("ClaimDecidedBy")
  claimsOverruled   ReplacementClaim[] @relation("ClaimOverruledBy")
  assignedFollowUpTasks FollowUpTask[]
  attendanceDays    AttendanceDay[]
  notifications     Notification[]   @relation("NotificationRecipient")
  notificationsCleared Notification[] @relation("NotificationClearedBy")
  totpSecret        String?
  totpEnabled       Boolean          @default(false)
  status            String           @default("active") // pending_invite, active, deactivated
  inviteTokenHash   String?          @unique // SHA-256 of the one-time invite token; the raw token is never stored
  inviteExpiresAt   DateTime?
  /// SHA-256 of the last invite token that was redeemed, so the invite page can
  /// say "already used" instead of "not valid". Never a usable credential.
  inviteUsedTokenHash String?        @unique
  deactivatedAt     DateTime?
  sessions          StaffSession[]
  passwordResets    StaffPasswordReset[] @relation("PasswordResetFor")
  passwordResetsIssued StaffPasswordReset[] @relation("PasswordResetIssuedBy")
  coachingNotes     StaffCoachingNote[] @relation("CoachingNoteAbout")
  coachingNotesWritten StaffCoachingNote[] @relation("CoachingNoteAuthor")
  companyPlansSet   CompanyPlan[]    @relation("CompanyPlanSetBy")
  teamPlans         TeamPlan[]       @relation("TeamPlanTeam")
  teamPlansSet      TeamPlan[]       @relation("TeamPlanSetBy")
  weeklyReports     WeeklyReport[]   @relation("WeeklyReportOwner")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([city])
  @@index([role])
  @@index([teamLeadId])
  @@index([reportsToId])
  @@index([lockedByStaffId])
}

model Payment {
  id                String      @id @default(uuid())
  code              String      @unique
  city              String      @default("Bengaluru")
  type              String      // activation, placement_fee, referral_payout, refund, joining_reward, duplicate_refund
  amount            Int         // paise
  status            String      @default("pending") // pending, approved, processing, succeeded, completed, failed, reversed, refunded, rejected (refund the CEO turned down)
  gatewayReference  String?     @unique
  method            String      @default("upi_direct") // upi_direct, gateway_card
  upiReference      String?     @unique
  expectedAmountPaise Int?
  bankUtr           String?     @unique
  confirmedBy       String?     // bank_feed, finance_manual, gateway
  confirmedByStaffId String?
  confirmedAt       DateTime?
  approvedByStaffId String?
  approvedAt        DateTime?
  paidAt            DateTime?
  paidByStaffId     String?
  payoutAccountId   String?
  payoutAccount     PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  payerUtrHint      String?
  subjectType       String      // job_seeker, business, referral, placement
  subjectId         String
  jobSeekerId       String?
  jobSeeker         JobSeeker?  @relation(fields: [jobSeekerId], references: [id], onDelete: SetNull)
  businessId        String?
  business          Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  referralId        String?
  referral          Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  placementId       String?
  placement         Placement?  @relation(fields: [placementId], references: [id], onDelete: SetNull)
  bankCredit        BankCredit?
  tdsReceivable     TdsReceivable?
  reactivation      Boolean     @default(false)
  // Approval limits (guide: Finance portal). Set when a refund needs the CEO:
  // above_finance_limit, goodwill (outside the rules) or sent_by_finance.
  ceoApprovalReason String?
  sentToCeoByStaffId String?
  sentToCeoAt       DateTime?
  outsideRules      Boolean     @default(false)
  approvalNote      String?
  // Phase 22: a payout the bank refused (account closed, name mismatch…), recorded by Finance.
  payoutFailureReason String?
  payoutFailedAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([subjectType, subjectId])
  @@index([jobSeekerId, type])
  @@index([placementId, type])
}

model BankCredit {
  id                String    @id @default(uuid())
  bankUtr           String    @unique
  amountPaise       Int
  receivedAt        DateTime
  payerName         String?
  payerVpaMasked    String?
  remark            String?
  source            String    // bank_feed, finance_manual
  enteredByStaffId  String?
  enteredByStaff    Staff?    @relation("BankCreditEnteredBy", fields: [enteredByStaffId], references: [id], onDelete: SetNull)
  status            String    @default("unmatched") // unmatched, matched, ignored
  matchedPaymentId  String?   @unique
  matchedPayment    Payment?  @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  tdsReceivable     TdsReceivable?
  ignoredReason     String?
  // Phase 22: unclaimed money is returned to the same UPI ID, never kept.
  returnedUtr       String?   @unique
  returnedAt        DateTime?
  returnedByStaffId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// One row per payout-status webhook event already applied (AGENTS.md §2 rule 7).
// `eventId` is the gateway's x-razorpay-event-id, so a redelivery is a no-op.
model PayoutWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       String
  outcome     String
  paymentId   String?
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// A placement fee that arrived short because the business deducted TDS.
// Finance records the short amount as "TDS deducted"; the certificate is then
// collected from the business. The TDS rate is not fixed in code (the CA confirms it).
model TdsReceivable {
  id                String     @id @default(uuid())
  city              String     @default("Bengaluru")
  placementId       String
  placement         Placement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  paymentId         String     @unique
  payment           Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bankCreditId      String?    @unique
  bankCredit        BankCredit? @relation(fields: [bankCreditId], references: [id], onDelete: SetNull)
  amountPaise       Int
  sectionNote       String
  status            String     @default("certificate_due") // certificate_due, certificate_received
  recordedByStaffId String
  recordedAt        DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([placementId])
  @@index([status])
}

model AuditLog {
  id            String    @id @default(uuid())
  code          String    @unique
  city          String    @default("Bengaluru")
  actorId       String
  actor         Staff?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityCode    String
  before        Json?
  after         Json?
  reason        String?
  changedFields String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([city])
  @@index([actorId])
  @@index([entityType, entityCode])
  @@index([createdAt])
}

model ContactAttempt {
  id           String        @id @default(uuid())
  jobSeekerId  String
  jobSeeker    JobSeeker     @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  channel      String        // call, whatsapp, sms
  outcome      String        // picked_up, no_pickup
  attemptedAt  DateTime      // stored in UTC
  timeOfDay    String        // am, pm
  hitId        String?
  hit          JobSeekerHit? @relation(fields: [hitId], references: [id], onDelete: SetNull)
  staffId      String?
  staff        Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  callRecordId String?       @unique
  callRecord   CallRecord?   @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  messageLogId String?       @unique
  messageLog   MessageLog?   @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([jobSeekerId])
  @@index([hitId])
  @@index([attemptedAt])
}

model JobSeekerHit {
  id                String           @id @default(uuid())
  jobSeekerId       String
  jobSeeker         JobSeeker        @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  reason            String           // no_pickup, offer_declined, offer_no_reply, interview_no_show
  note              String?
  recordedBy        String           // staffId or "system"
  recordedAt        DateTime         @default(now())
  interviewId       String?
  callRecordId      String?
  reversedAt        DateTime?
  reversedByStaffId String?
  reversedByStaff   Staff?           @relation("JobSeekerHitReversedBy", fields: [reversedByStaffId], references: [id], onDelete: SetNull)
  reversalReason    String?
  /// Set when he paid ₹499 again after deactivation: hits from the earlier
  /// guarantee no longer count towards hits, the refund or matching.
  supersededAt      DateTime?
  contactAttempts   ContactAttempt[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([jobSeekerId])
  @@index([recordedAt])
  @@index([jobSeekerId, reason])
  @@index([reversedAt])
  @@index([jobSeekerId, supersededAt])
}

model BusinessVisit {
  id           String    @id @default(uuid())
  /// Null while the shop is not (yet) registered: a "Visit a shop" visit
  /// starts outside, before anyone knows whether the shop will sign up.
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId      String?
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  latitude     Float
  longitude    Float
  /// GPS accuracy (metres) of the reading taken outside at the start.
  accuracyMeters Float?
  /// Proof selfie (verification visits and the "proof before onboarding" step):
  /// storage path and SHA-256 of the uploaded bytes.
  selfieUrl    String?
  selfieHash   String?
  geofenceFlag Boolean   @default(false)
  purpose      String?
  ownerOtpRequestId String?
  photoLive    Boolean?
  assignmentId String?
  assignment   VisitAssignment? @relation("VisitAssignmentBusinessVisit", fields: [assignmentId], references: [id], onDelete: SetNull)
  completedAssignment VisitAssignment? @relation("VisitAssignmentVisit")
  /// Name on the shop board as the agent typed it (before registration).
  shopName     String?
  /// The earlier visit to the same unregistered shop this one returns to.
  revisitOfVisitId String?
  /// Live photo of the shop with its name board, taken outside before going in.
  boardPhotoPath    String?
  boardPhotoHash    String?
  boardPhotoTakenAt DateTime?
  /// Visit timer: from the board photo to stepping out / choosing the outcome.
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  /// owner, manager, staff, no_one
  spokeTo           String?
  /// Optional shop phone the Team Lead may call to check (+91 and 10 digits).
  contactPhone      String?
  /// onboarded, interested_later, not_interested, owner_not_there
  outcome           String?
  /// Not interested: hires_family_friends, fee_too_high, no_staff_needed, other_agency, other
  outcomeReason     String?
  /// Come back on this IST date (interested later, owner not there).
  revisitOn         DateTime? @db.Date
  note              String?
  outcomeRecordedAt DateTime?
  /// Second GPS check with the proof selfie, and its distance from the start.
  proofLatitude       Float?
  proofLongitude      Float?
  proofAccuracyMeters Float?
  proofAt             DateTime?
  proofDistanceMeters Float?
  /// One of the faked-GPS checks failed (see visit-fraud.ts).
  gpsSuspect        Boolean   @default(false)
  visitedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([businessId])
  @@index([selfieHash])
  @@index([boardPhotoHash])
  @@index([staffId, visitedAt])
  @@index([revisitOfVisitId])
  @@index([revisitOn])
}

model VisitAssignment {
  id                String       @id @default(uuid())
  businessId        String
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purpose           String
  suggestedStaffId  String?
  suggestedStaff    Staff?       @relation("VisitAssignmentSuggested", fields: [suggestedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId   String?
  assignedStaff     Staff?       @relation("VisitAssignmentAssigned", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedByStaffId String?
  assignedByStaff   Staff?       @relation("VisitAssignmentAssignedBy", fields: [assignedByStaffId], references: [id], onDelete: SetNull)
  status            String       @default("pending")
  relatedType       String?
  relatedId         String?
  visitId           String?      @unique
  visit             BusinessVisit? @relation("VisitAssignmentVisit", fields: [visitId], references: [id], onDelete: SetNull)
  businessVisits    BusinessVisit[] @relation("VisitAssignmentBusinessVisit")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([businessId, status])
  @@index([assignedStaffId, status])
}

model FieldCheckIn {
  id             String   @id @default(uuid())
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  accuracyMeters Float
  checkedInAt    DateTime @default(now())

  @@index([staffId, checkedInAt])
}

model CallbackTask {
  id                String      @id @default(uuid())
  callId            String      @unique
  phone             String
  callerName        String?
  virtualNumber     String      @default("18001234567")
  jobSeekerId       String?
  jobSeeker         JobSeeker?  @relation(fields: [jobSeekerId], references: [id], onDelete: SetNull)
  status            String      @default("pending") // pending, assigned, completed
  assignedToStaffId String?
  assignedToStaff   Staff?      @relation(fields: [assignedToStaffId], references: [id], onDelete: SetNull)
  recordingUrl      String?
  recordingConsent  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model StaffDevice {
  id                String    @id @default(uuid())
  staffId           String
  staff             Staff     @relation("StaffDeviceOwner", fields: [staffId], references: [id], onDelete: Cascade)
  deviceId          String
  label             String
  platform          String
  status            String    @default("pending") // pending, approved, revoked
  requestedAt       DateTime?
  approvedAt        DateTime?
  revokedAt         DateTime?
  lastSeenAt        DateTime?
  approvedByStaffId String?
  approvedByStaff   Staff?    @relation("StaffDeviceApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  revokedByStaffId  String?
  revokedByStaff    Staff?    @relation("StaffDeviceRevokedBy", fields: [revokedByStaffId], references: [id], onDelete: SetNull)
  loginCodeRequests LoginCodeRequest[]

  @@unique([staffId, deviceId])
  @@index([staffId])
  @@index([status])
  @@index([approvedByStaffId])
  @@index([revokedByStaffId])
}

model OfficeNetwork {
  id             String   @id @default(uuid())
  label          String
  cidr           String
  active         Boolean  @default(true)
  addedByStaffId String?
  addedByStaff   Staff?   @relation("OfficeNetworkAddedBy", fields: [addedByStaffId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([active])
  @@index([addedByStaffId])
}

model LoginCodeRequest {
  id                String      @id @default(uuid())
  staffId           String
  staff             Staff       @relation("LoginCodeSubject", fields: [staffId], references: [id], onDelete: Cascade)
  staffDeviceId     String
  staffDevice       StaffDevice @relation(fields: [staffDeviceId], references: [id], onDelete: Cascade)
  ipAddress         String
  onOfficeNetwork   Boolean
  status            String      @default("pending") // pending, revealed, used, expired, refused
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  revealedByStaffId String?
  revealedByStaff   Staff?      @relation("LoginCodeRevealedBy", fields: [revealedByStaffId], references: [id], onDelete: SetNull)
  revealedAt        DateTime?
  usedAt            DateTime?
  refusedByStaffId  String?
  refusedByStaff    Staff?      @relation("LoginCodeRefusedBy", fields: [refusedByStaffId], references: [id], onDelete: SetNull)
  refusedReason     String?
  sessions          StaffSession[]

  @@index([staffId, status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([revealedByStaffId])
  @@index([refusedByStaffId])
}

model StaffSession {
  id                 String            @id @default(uuid())
  staffId            String
  staff              Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Laboura Field only: SHA-256 of the refresh token that restores the session
  /// when the app is reopened. Office sessions never get one.
  tokenHash          String?
  deviceId           String?
  ipAddress          String?
  userAgent          String?
  revokedAt          DateTime?
  expiresAt          DateTime
  lastActivityAt     DateTime          @default(now())
  /// login time + maxSessionMinutes; refresh never moves this
  absoluteExpiresAt  DateTime
  /// logout, idle, max_length, replaced, locked, revoked
  endedReason        String?
  loginCodeRequestId String?
  loginCodeRequest   LoginCodeRequest? @relation(fields: [loginCodeRequestId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([staffId])
  @@index([revokedAt])
  @@index([loginCodeRequestId])
}

model JobRun {
  id           String    @id @default(uuid())
  jobName      String
  startedAt    DateTime
  finishedAt   DateTime?
  outcome      String
  evaluated    Int       @default(0)
  hitsRecorded Int       @default(0)
  details      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobName, outcome, finishedAt])
  @@index([createdAt])
}

model JobAlertState {
  jobName         String    @id
  isStale         Boolean   @default(false)
  lastAlertedAt   DateTime?
  lastRecoveredAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model Target {
  id                         String    @id @default(uuid())
  staffId                    String
  staff                      Staff     @relation("StaffTargets", fields: [staffId], references: [id], onDelete: Cascade)
  year                       Int
  month                      Int       // 1 - 12
  // Call Agent metrics (Task 3)
  candidatesActivated        Int?      // count floor
  refundRate                 Float?    // ratio ceiling (e.g. 0.05 for 5%)
  vacanciesCaptured          Int?      // count floor
  // Field Agent metrics (Task 4)
  placementsClosed           Int?      // count floor
  replacementsInside15Days   Int?      // count floor
  repeatBusinesses           Int?      // count floor
  createdById                String
  createdBy                  Staff     @relation("CreatedTargets", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById                String?
  updatedBy                  Staff?    @relation("UpdatedTargets", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([staffId, year, month])
  @@index([staffId])
  @@index([year, month])
}

model PricingPolicy {
  id                           String    @id @default(uuid())
  activationFeePaise           Int
  placementFeePercent          Int
  gstPercent                   Int
  referralPayoutPaise          Int
  joiningRewardPaise           Int
  joiningRewardAfterDays       Int
  jobSeekerGuaranteeDays       Int
  offerReplyHours              Int
  maxHits                      Int
  interviewResultDeadline      String
  interviewResultCloseHours    Int       @default(48)
  interviewResultEscalateHours Int
  placementPaymentDueHours     Int
  replacementWindowDays        Int
  replacementSearchDays        Int
  maxFreeReplacements          Int
  maxReplacementRejections     Int
  claimReportDays              Int
  claimDecisionHours           Int
  noBypassMonths               Int
  noBypassPenaltyPercent       Int
  payoutDetailsCoolingHours    Int
  idleLogoutMinutes            Int
  maxSessionMinutes            Int
  loginCodeValidMinutes        Int
  failedLoginLimit             Int
  lockoutMinutes               Int
  callingHoursStart            String
  callingHoursEnd              String
  duplicateBusinessRadiusMeters Int @default(50)
  consentWithdrawalCallWindowMinutes Int @default(60)
  walkInStart                  String    @default("10:30")
  walkInEnd                    String    @default("18:00")
  matchPageSize                Int       @default(3)
  salaryDaysPerMonth           Int       @default(26)
  legalMinimumWageUnskilledPaise     Int      @default(2337600)
  legalMinimumWageSemiSkilledPaise   Int      @default(2571400)
  legalMinimumWageSkilledPaise       Int      @default(2828600)
  legalMinimumWageHighlySkilledPaise Int      @default(3111400)
  legalMinimumWageEffectiveFrom      DateTime @default("2026-05-22T00:00:00.000Z") @db.Date
  matchingWeights              Json      @default("{\"clock\":30,\"distance\":20,\"experience\":15,\"salary\":15,\"reliability\":10,\"completeness\":5,\"pastResults\":5}")
  adultMinimumAge              Int       @default(18)
  followUpGraceDays            Int       @default(2)
  patternWindowDays            Int       @default(60)
  patternBusinessMinInterviews Int       @default(5)
  patternStopDays              Int       @default(30)
  patternAgentMinInterviews    Int       @default(10)
  patternAgentRejectionPercent Int       @default(80)
  shiftStart                   String    @default("09:30")
  shiftEnd                     String    @default("18:30")
  productionHoursFullDay       Float     @default(8)
  halfDayBelowHours            Float     @default(4.5)
  dayToleranceMinutes          Int       @default(10)
  lateGraceMinutes             Int       @default(10)
  shortBreakMinutes            Int       @default(15)
  lunchMinutes                 Int       @default(30)
  idleAfterMinutes             Int       @default(10)
  casualLeavePerMonth          Int       @default(1)
  emergencyLeavePerMonth       Int       @default(1)
  refundPriorityWindowDays     Int       @default(15)
  // Shop-visit checks for the Team Lead (field agent app, decided 9 Nov). The
  // guide names the checks; these numbers are settings, not rules.
  /// A visit shorter than this is flagged as "very short".
  visitShortMinutes            Int       @default(3)
  /// Two visits further apart than this speed allows are flagged.
  visitMaxTravelKmh            Int       @default(60)
  /// The proof selfie must be taken within this distance of the board photo.
  visitSameSpotMeters          Int       @default(100)
  /// This many visits in the window with no onboarding is flagged.
  visitNoOnboardingCount       Int       @default(15)
  visitNoOnboardingDays        Int       @default(7)
  /// Weekly days off, 0 = Sunday … 6 = Saturday (IST). No absent day is
  /// marked on them; time worked on them is make-up time.
  weeklyOffDays                Int[]     @default([0])
  // Approval limits (only the CEO changes them). Finance approves and pays up to
  // these amounts; above them, or for any refund outside the rules, the CEO decides.
  financeBusinessRefundLimitPaise Int    @default(1500000)
  financeExpenseLimitPaise     Int       @default(1000000)
  // Referral payouts are commission: Finance is warned before a partner's
  // yearly total crosses this TDS limit (guide, tax handling; CA to confirm).
  referralTdsYearlyLimitPaise  Int       @default(2000000)
  // Company details printed on GST invoices (entered by the CEO in Settings).
  companyLegalName             String    @default("Laboura Private Limited")
  companyGstin                 String?
  companyAddress               String?
  effectiveFrom                DateTime  @default(now())
  setByStaffId                 String?
  setByStaff                   Staff?    @relation("PricingPolicySetBy", fields: [setByStaffId], references: [id], onDelete: SetNull)
  createdAt                    DateTime  @default(now())

  @@index([effectiveFrom])
}

model AttendanceDay {
  id                String              @id @default(uuid())
  staffId           String
  staff             Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// IST calendar date. Stored as a date, not a timestamp.
  date              DateTime            @db.Date
  /// Null on a day with no login: an absent day or a leave day.
  loginAt           DateTime?
  logoutAt          DateTime?
  loginLat          Float?
  loginLng          Float?
  lateMinutes       Int                 @default(0)
  productionSeconds Int                 @default(0)
  breakSeconds      Int                 @default(0)
  idleSeconds       Int                 @default(0)
  dayType           String              @default("open") // full, half, absent, leave, off, open
  closedReason      String?             // logout, auto_closed_no_logout, no_login
  flagged           Boolean             @default(false)
  /// Production below the full-day line on a full day. Zero on a half day,
  /// inside the tolerance, and after a Team Lead or Manager changes the day.
  shortfallSeconds  Int                 @default(0)
  /// Production above the full-day line. Reduces the month's shortfall.
  makeUpSeconds     Int                 @default(0)
  /// On a leave day: casual or emergency, and whether it is beyond the paid balance.
  leaveKind         String?
  leaveUnpaid       Boolean             @default(false)
  /// Set when a Team Lead or Manager changes the day to full or half.
  dayTypeChangedById String?
  dayTypeChangedAt  DateTime?
  dayTypeChangeReason String?
  /// The approved leave request that made this a leave day.
  leaveRequestId    String?
  lastHeartbeatAt   DateTime?
  segments          AttendanceSegment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

/// A public holiday: a paid day off for everyone, set by the CEO per year.
/// Never absent, not a leave day, not a working day.
/// Bengaluru areas agents pick on every form (guide, Forms: "Areas: picked
/// from a list of Bengaluru areas that the CEO and Managers manage in the
/// Command Center"). Never deleted: a duplicate is merged into another area
/// (records move to its name) and switched off.
model Area {
  id               String   @id @default(uuid())
  name             String
  /// Lower-case name with spaces collapsed; unique so "HSR layout" and "HSR Layout" are one area.
  nameKey          String   @unique
  pincode          String?
  latitude         Float?
  longitude        Float?
  active           Boolean  @default(true)
  mergedIntoId     String?
  createdByStaffId String?
  updatedByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
}

model Holiday {
  id               String   @id @default(uuid())
  /// IST calendar date.
  date             DateTime @unique @db.Date
  name             String
  createdByStaffId String?
  updatedByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Leave days earned on the 1st of each month. One row per person per month.
model LeaveAccrual {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month     String   // YYYY-MM (IST)
  casual    Int
  emergency Int
  createdAt DateTime @default(now())

  @@unique([staffId, month])
}

/// A leave request. Routing follows the reporting line (Phase 21 Task 4).
model LeaveRequest {
  id                  String    @id @default(uuid())
  staffId             String
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind                String    // casual, emergency
  fromDate            DateTime  @db.Date
  toDate              DateTime  @db.Date
  /// Leave days in the range, weekly days off left out.
  days                Int
  reason              String
  status              String    @default("pending") // pending, approved, rejected
  /// Where it went first: team_lead, manager or ceo.
  routedToRole        String
  routedToStaffId     String?
  /// team_lead, team_lead_own, over_limit, manager_own, finance_own, no_line
  routeReason         String
  forwardedAt         DateTime?
  forwardedByStaffId  String?
  forwardNote         String?
  decidedAt           DateTime?
  decidedByStaffId    String?
  decidedByRole       String?
  decisionReason      String?
  paidDays            Int       @default(0)
  unpaidDays          Int       @default(0)
  overturnedAt        DateTime?
  overturnedByStaffId String?
  overturnReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([staffId, status])
  @@index([status, createdAt])
}

/// A request to change a time range of a day. Staff never edit their own times.
model AttendanceCorrection {
  id                  String    @id @default(uuid())
  staffId             String
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date                DateTime  @db.Date
  startAt             DateTime
  endAt               DateTime
  /// The status the person says they were in (a production status).
  segmentStatus       String    @default("available")
  reason              String
  /// The person's nth correction in that month, counting this one.
  monthNumber         Int
  status              String    @default("pending") // pending, approved, rejected
  routedToRole        String
  routedToStaffId     String?
  /// team_lead, team_lead_own, third_correction, manager_own, finance_own, no_line
  routeReason         String
  forwardedAt         DateTime?
  forwardedByStaffId  String?
  forwardNote         String?
  decidedAt           DateTime?
  decidedByStaffId    String?
  decidedByRole       String?
  decisionReason      String?
  /// The segments as they were before the correction was applied.
  replacedSegments    Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([staffId, status])
  @@index([status, createdAt])
}

model AttendanceSegment {
  id                String        @id @default(uuid())
  staffId           String
  dayId             String
  day               AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  status            String
  startedAt         DateTime
  endedAt           DateTime?
  source            String        // staff, phone_system, check_in, idle_detector, correction
  approvedAt        DateTime?
  approvedByStaffId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([dayId, startedAt])
  @@index([staffId])
}

model StatusHistory {
  id               String   @id @default(uuid())
  subjectType      String   // job_seeker, business, vacancy, interview, placement, replacement_claim, payment, referral, staff
  subjectId        String
  fromStatus       String?
  toStatus         String
  changedByStaffId String?
  changedByStaff   Staff?   @relation("StatusHistoryChangedBy", fields: [changedByStaffId], references: [id], onDelete: SetNull)
  reason           String?
  changedAt        DateTime @default(now())

  @@index([subjectType, subjectId, changedAt])
  @@index([changedByStaffId])
}

model ReviewFlag {
  id                String    @id @default(uuid())
  code              String    @unique
  kind              String    // see closed list in review-flag.constants.ts
  subjectType       String    // business, placement, payment, staff, job_seeker, etc.
  subjectId         String
  raisedForStaffId  String?
  raisedForStaff    Staff?    @relation("ReviewFlagRaisedFor", fields: [raisedForStaffId], references: [id], onDelete: SetNull)
  details           Json?
  status            String    @default("open") // open, resolved, dismissed
  raisedAt          DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedByStaffId String?
  resolvedByStaff   Staff?    @relation("ReviewFlagResolvedBy", fields: [resolvedByStaffId], references: [id], onDelete: SetNull)
  resolution        String?
  /// Who decides the flag now: team_lead, manager or ceo. Money and bypass
  /// flags are always the CEO's. Moved up by "Send to Manager" / "Send to CEO".
  ownerRole         String?
  /// The Manager it was sent to (ownerRole manager); null for the CEO.
  ownerStaffId      String?
  escalatedAt       DateTime?
  escalatedByStaffId String?
  escalationNote    String?

  @@index([status, raisedAt])
  @@index([raisedForStaffId])
  @@index([ownerRole, status])
}

model CallRecord {
  id                   String    @id @default(uuid())
  code                 String    @unique
  provider             String
  providerCallId       String
  direction            String? // outbound, inbound
  staffId              String?
  staff                Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  subjectType          String? // job_seeker, business, referral
  subjectId            String?
  purpose              String? // offer, follow_up, verification, exit_call, check_in, interview_result, refund_check, joining_confirmation, general
  relatedType          String?
  relatedId            String?
  /// written only by the call-status webhook
  providerStatus       String
  /// written only by the call-status webhook
  answered             Boolean   @default(false)
  startedAt            DateTime?
  answeredAt           DateTime?
  endedAt              DateTime?
  durationSec          Int?
  recordingStoragePath String?
  recordingDeletedAt   DateTime?
  announcementPlayed   Boolean   @default(false)
  agentOutcome         String?
  agentOutcomeReason   String?
  agentOutcomeAt       DateTime?
  contactAttempt       ContactAttempt?
  interviewReply       Interview?
  placementsAsWorkerJoining   Placement[] @relation("PlacementJoiningWorkerCall")
  placementsAsBusinessJoining Placement[] @relation("PlacementJoiningBusinessCall")
  exitCallClaims              ReplacementClaim[] @relation("ExitCallRecord")
  callRecordClaims            ReplacementClaim[] @relation("ClaimCallRecord")
  followUpTasks               FollowUpTask[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([provider, providerCallId])
  @@index([staffId])
  @@index([subjectType, subjectId])
}

model MessageLog {
  id                String    @id @default(uuid())
  channel           String // sms, whatsapp
  template          String
  subjectType       String
  subjectId         String
  relatedType       String?
  relatedId         String?
  providerMessageId String?   @unique
  status            String // queued, sent, delivered, read, failed
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  contactAttempt    ContactAttempt?
  candidateIntroductions CandidateIntroduction[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([subjectType, subjectId])
  @@index([status])
}

model CandidateIntroduction {
  id              String   @id @default(uuid())
  businessId      String
  vacancyId       String
  jobSeekerId     String
  shownByStaffId  String
  shownAt         DateTime @default(now())
  rank            Int
  score           Float
  matchReasons    Json
  channel         String // share_link, in_person
  messageLogId    String?
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  vacancy         Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  shownBy         Staff     @relation("CandidateIntroductionShownBy", fields: [shownByStaffId], references: [id], onDelete: Restrict)
  messageLog      MessageLog? @relation(fields: [messageLogId], references: [id], onDelete: Restrict)

  @@index([businessId, jobSeekerId, shownAt])
  @@index([vacancyId, shownAt])
  @@index([messageLogId])
}

model CandidateIntroductionLink {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  businessId   String
  vacancyId    String
  jobSeekerIds String[]
  consumedAt   DateTime?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  vacancy      Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Restrict)

  @@index([businessId, vacancyId])
}

model Consent {
  id            String    @id @default(uuid())
  subjectType   String    // job_seeker, business, referral, staff
  subjectId     String
  purpose       String    // job_matching, profile_sharing, call_recording, aadhaar_verification, job_updates, promotions
  granted       Boolean   @default(false)
  noticeVersion String
  language      String    // kn, hi, en
  method        String    // sms_link, in_app, contract
  otpRequestId  String?
  grantedAt     DateTime?
  withdrawnAt   DateTime?
  withdrawnMethod       String?
  withdrawnByStaffId    String?
  withdrawnCallRecordId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([subjectType, subjectId, purpose, noticeVersion])
  @@index([subjectType, subjectId])
}

model BusinessAgreement {
  id                     String   @id @default(uuid())
  businessId             String
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  version                String
  termsHash              String
  noBypassMonths         Int
  noBypassPenaltyPercent Int
  feePercent             Int
  gstPercent             Int
  signedName             String
  signedPhone            String
  signedRole             String?
  otpRequestId           String
  signedAt               DateTime
  documentStoragePath    String
  createdAt              DateTime @default(now())

  @@index([businessId, signedAt])
}

model FollowUpTask {
  id               String      @id @default(uuid())
  code             String      @unique
  kind             String      // not_selected_day_7, not_selected_day_30, not_selected_day_90, placement_check_in_day_7, placement_check_in_day_30, refund_check, exit_call
  subjectType      String      // job_seeker, business
  subjectId        String
  relatedType      String?     // interview, placement, claim
  relatedId        String?
  dueAt            DateTime
  assignedStaffId  String?
  assignedStaff    Staff?      @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  status           String      @default("pending") // pending, done, missed
  callRecordId     String?
  callRecord       CallRecord? @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  answer           String?     // working_at_introduced_business, working_elsewhere, not_working, no_answer
  answerBusinessId String?
  answerBusiness   Business?   @relation("FollowUpAnswerBusiness", fields: [answerBusinessId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, dueAt])
  @@index([subjectType, subjectId])
  @@index([assignedStaffId])
  @@index([kind])
}

model PayoutAccount {
  id                    String    @id @default(uuid())
  code                  String    @unique
  ownerType             String    // referral, job_seeker, business
  ownerId               String
  ownerNameAtEntry      String
  method                String    // upi, bank
  maskedValue           String
  valueHash             String
  upiIdEncrypted        String?
  bankAccountEncrypted  String?
  ifsc                  String?
  verifiedName          String?
  nameMatches           Boolean?
  status                String    @default("pending_validation") // pending_validation, verified, flagged, superseded
  validatedAt           DateTime?
  activeFrom            DateTime
  changeOtpRequestId    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  payments              Payment[]

  @@index([ownerType, ownerId])
  @@index([valueHash])
  @@index([status])
}




/// N3 (confirmed 11 Nov): a trade and area where open vacancies have no matching
/// available job seeker. One open task per trade and area for the Team Lead; the
/// daily sweep closes it by itself when supply appears.
model ShortageTask {
  id                 String    @id @default(uuid())
  /// "tradeKey|areaKey" while the task is open, null once closed: at most one open task per trade and area.
  openKey            String?   @unique
  city               String    @default("Bengaluru")
  tradeKey           String
  trade              String
  areaKey            String
  area               String
  status             String    @default("open") // open, closed
  /// Positions still open on the vacancies with no match (sum of headcount).
  openPositions      Int
  vacancyIds         String[]  @default([])
  assignedTeamLeadId String?
  title              String
  openedAt           DateTime
  lastCheckedAt      DateTime
  closedAt           DateTime?
  closedReason       String?   // supply_appeared, no_open_vacancies
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, assignedTeamLeadId])
  @@index([tradeKey, areaKey])
}

/// N5 (confirmed 11 Nov): a refunded or deactivated job seeker matched by a new or
/// reopened vacancy, on the call agents' list to register again.
model WinBackEntry {
  id                String    @id @default(uuid())
  /// The job seeker's id while the entry is open, null once closed: one open entry per person.
  openKey           String?   @unique
  jobSeekerId       String
  /// The vacancy that put him on the list.
  vacancyId         String
  reason            String    // refunded, deactivated
  status            String    @default("open") // open, re_registered, declined, closed
  addedAt           DateTime
  closedAt          DateTime?
  closedReason      String?   // re_registered, said_no, consent_withdrawn, no_longer_eligible
  closedByStaffId   String?
  callRecordId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([jobSeekerId, vacancyId])
  @@index([status, addedAt])
  @@index([jobSeekerId])
}

/// A call the system has put back on an agent's list for a set time
/// (Master Guide, "What happens when things don't go to plan"):
/// - callback: the person asked to be called back at this date and time;
/// - retry: the calling system reported no answer, so the call is tried again.
/// Read by the call agent's work queue and "Call next".
model CallTask {
  id                 String    @id @default(uuid())
  /// The agent whose list it goes on.
  staffId            String
  subjectType        String    // job_seeker, business, referral
  subjectId          String
  kind               String    // callback, retry
  dueAt              DateTime
  status             String    @default("open") // open, done, cancelled
  /// The call that produced it. One task per call and kind, so a repeated
  /// webhook never adds a second retry.
  sourceCallRecordId String?
  /// The call that closed it.
  doneCallRecordId   String?
  doneAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([sourceCallRecordId, kind])
  @@index([staffId, status, dueAt])
  @@index([subjectType, subjectId, status])
}

/// Phase 21 Task 6: one bell item for one staff member. A notification clears
/// by itself when the work behind it is done; who did it is recorded.
model Notification {
  id               String    @id @default(uuid())
  recipientStaffId String
  recipient        Staff     @relation("NotificationRecipient", fields: [recipientStaffId], references: [id], onDelete: Cascade)
  /// Closed list in src/modules/notification/notification.constants.ts.
  kind             String
  title            String
  body             String?
  /// In-app path (web app, without /app) where the work is done.
  link             String?
  subjectType      String
  subjectId        String
  /// "recipient|kind|subjectType|subjectId" while open, null once cleared:
  /// at most one open notification per recipient, kind and subject.
  openKey          String?   @unique
  seenAt           DateTime?
  createdAt        DateTime  @default(now())
  clearedAt        DateTime?
  clearedByStaffId String?
  clearedBy        Staff?    @relation("NotificationClearedBy", fields: [clearedByStaffId], references: [id], onDelete: SetNull)
  clearedReason    String?

  @@index([recipientStaffId, clearedAt])
  @@index([kind, clearedAt])
  @@index([subjectType, subjectId])
}

/// Phase 22 (Finance back office, part A): a bill or expense entered by Finance
/// or the CEO with the bill attached. Finance approves up to its limit in
/// Settings; above it the CEO decides. Salaries, payouts, rewards and refunds
/// are never entered here — they are read from payroll and payments.
model Expense {
  id                 String    @id @default(uuid())
  code               String    @unique
  city               String    @default("Bengaluru")
  category           String    // rent, calling, sms_whatsapp, id_checks, hosting, ads_marketing, field_travel, office_other
  supplier           String
  description        String
  adChannel          String?   // ads_marketing only
  amountPaise        Int       // what was paid, GST included
  gstPaise           Int       @default(0)
  billDate           DateTime
  paidFrom           String?   // bank_transfer, upi, card, cash
  billPath           String?
  billFileName       String?
  billContentType    String?
  status             String    @default("waiting_finance") // waiting_finance, waiting_ceo, approved, paid, rejected
  needsCeo           Boolean   @default(false)
  enteredByStaffId   String
  approvedByStaffId  String?
  approvedAt         DateTime?
  rejectedByStaffId  String?
  rejectedAt         DateTime?
  rejectionReason    String?
  paidByStaffId      String?
  paidAt             DateTime?
  paymentReference   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([billDate])
  @@index([category])
}

/// Phase 22: the CEO's monthly budget for one expense category (month = IST yyyy-mm).
model ExpenseBudget {
  id           String   @id @default(uuid())
  month        String
  category     String
  amountPaise  Int
  setByStaffId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([month, category])
}

/// Phase 22: one IST day of the bank account closed by Finance — our books
/// against the bank statement's closing balance.
model BankDayClose {
  id                String   @id @default(uuid())
  day               String   @unique // IST yyyy-mm-dd
  openingPaise      Int
  inPaise           Int
  outPaise          Int
  booksClosingPaise Int
  bankClosingPaise  Int
  differencePaise   Int
  note              String?
  closedByStaffId   String
  closedAt          DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Server side of the field app's offline queue: every queued write carries
/// an Idempotency-Key. A repeat of a key already answered gets the saved
/// answer back instead of saving the visit or photo twice.
model IdempotencyRecord {
  id             String    @id @default(uuid())
  staffId        String
  key            String
  method         String
  path           String
  /// processing, done
  state          String    @default("processing")
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([staffId, key])
  @@index([createdAt])
}

/// The owner's favourite candidates for a vacancy (the heart on the field
/// agent's match cards). Marked by the field agent in the shop.
model OwnerFavourite {
  id              String   @id @default(uuid())
  vacancyId       String
  vacancy         Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  jobSeekerId     String
  markedByStaffId String
  createdAt       DateTime @default(now())

  @@unique([vacancyId, jobSeekerId])
  @@index([jobSeekerId])
}

/// A password reset issued by a Team Lead (own agents), a Manager (own tree)
/// or the CEO. Works like a new invite link: the person sets a new password
/// on the invite page; the old password keeps working until the link is used.
/// Kept so the CEO's audit can see who reset whom. Only the SHA-256 of the
/// token is stored.
model StaffPasswordReset {
  id              String    @id @default(uuid())
  staffId         String
  staff           Staff     @relation("PasswordResetFor", fields: [staffId], references: [id], onDelete: Cascade)
  issuedByStaffId String
  issuedBy        Staff     @relation("PasswordResetIssuedBy", fields: [issuedByStaffId], references: [id], onDelete: Restrict)
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  /// Set when a newer reset replaced this one, or the account was deactivated.
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([issuedByStaffId])
}

/// Coaching notes and written warnings about a staff member (Manager portal,
/// MG-Agent and MG-TL). Seen by the person's Team Lead, Managers above them
/// and the CEO. Only a Manager or the CEO gives a written warning.
model StaffCoachingNote {
  id            String   @id @default(uuid())
  staffId       String
  staff         Staff    @relation("CoachingNoteAbout", fields: [staffId], references: [id], onDelete: Cascade)
  authorStaffId String
  author        Staff    @relation("CoachingNoteAuthor", fields: [authorStaffId], references: [id], onDelete: Restrict)
  /// note, written_warning
  kind          String   @default("note")
  text          String
  createdAt     DateTime @default(now())

  @@index([staffId, createdAt])
}

/// Requests a Team Lead, Manager or the CEO decides that have no table of
/// their own (Team Lead portal T-Requests, Manager portal MG-Requests): a hit
/// removal, a target change, a day change, a written warning. Leave,
/// corrections, devices and replacement claims stay in their own tables and
/// are read through the same requests read model (src/modules/requests).
/// Routed like leave: routedToRole / routedToStaffId / routeReason, with the
/// 24-hour (Team Lead) and 48-hour (Manager) escalation worked out from the clock.
model StaffRequest {
  id                  String    @id @default(uuid())
  /// hit_removal, target_change, day_change, written_warning
  kind                String
  /// The staff member the request is about (scope and routing follow them).
  staffId             String
  requestedByStaffId  String
  /// job_seeker_hit, target, attendance_day, staff
  subjectType         String
  subjectId           String
  details             Json
  reason              String
  /// pending, approved, rejected
  status              String    @default("pending")
  routedToRole        String
  routedToStaffId     String?
  routeReason         String
  forwardedAt         DateTime?
  forwardedByStaffId  String?
  forwardNote         String?
  decidedAt           DateTime?
  decidedByStaffId    String?
  decidedByRole       String?
  decisionReason      String?
  overturnedAt        DateTime?
  overturnedByStaffId String?
  overturnReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, routedToRole])
  @@index([staffId, status])
  @@index([kind, subjectId])
  @@index([decidedAt])
}

/// A Team Lead's checklist score for one recorded call (T-Quality). Minimal on
/// purpose: six yes/no checks, the score out of 100, and a note.
model CallQualityScore {
  id              String   @id @default(uuid())
  callRecordId    String   @unique
  staffId         String
  scoredByStaffId String
  checks          Json
  score           Int
  note            String?
  flagged         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId, createdAt])
  @@index([scoredByStaffId])
}

/// A Team Lead's check of a registration (T-Verify) or a shop visit (T-Visits):
/// "Looks right", or "Fake" / "Flag" with the review flag it opened.
model TeamLeadCheck {
  id               String   @id @default(uuid())
  /// job_seeker, business_visit
  subjectType      String
  subjectId        String
  /// ok, fake, flagged
  verdict          String
  note             String?
  flagId           String?
  checkedByStaffId String
  createdAt        DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([checkedByStaffId, createdAt])
}

/// The CEO's plan for one month for the whole company (Master Guide, Manager
/// home: "The CEO sets the monthly target; the Manager splits it into team and
/// agent targets"). Counts only — never money. Each field is optional: a metric
/// the CEO leaves empty falls back to the sum of the agents' targets.
model CompanyPlan {
  id                 String   @id @default(uuid())
  year               Int
  month              Int      // 1 - 12
  registered         Int?     // job seekers registered
  paid               Int?     // paid the ₹499 registration fee
  businessesSignedUp Int?     // businesses signed up (agreement by OTP)
  vacancies          Int?     // new job openings added
  interviewsDone     Int?     // interviews done
  placed             Int?     // people placed in jobs
  leftWithin30       Int?     // a limit: placed people who left within 30 days, at most this many
  repeatBusinesses   Int?     // businesses that hired through Laboura again
  setByStaffId       String
  setBy              Staff    @relation("CompanyPlanSetBy", fields: [setByStaffId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([year, month])
}

/// A Manager's split of the CEO's plan for one team (a Team Lead's team) and
/// month (MG-Targets "Split the CEO's plan into teams"). The same metrics as
/// CompanyPlan; the teams' splits should add up to the CEO's plan.
model TeamPlan {
  id                 String   @id @default(uuid())
  teamLeadId         String
  teamLead           Staff    @relation("TeamPlanTeam", fields: [teamLeadId], references: [id], onDelete: Cascade)
  year               Int
  month              Int      // 1 - 12
  registered         Int?
  paid               Int?
  businessesSignedUp Int?
  vacancies          Int?
  interviewsDone     Int?
  placed             Int?
  leftWithin30       Int?
  repeatBusinesses   Int?
  setByStaffId       String
  setBy              Staff    @relation("TeamPlanSetBy", fields: [setByStaffId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([teamLeadId, year, month])
  @@index([year, month])
}

/// The Monday weekly report, kept as it was sent (MG-Reports "sent every
/// Monday at 9 AM", C-Reports): one per Manager's tree and one for the whole
/// company (the CEO's) per week, so a past week opens as it was. A Manager's
/// content is counts only; the company one holds the CEO's report with money.
model WeeklyReport {
  id           String   @id @default(uuid())
  /// "manager:<staffId>" or "company" — at most one report per scope and week.
  scopeKey     String
  scope        String   // manager, company
  ownerStaffId String?
  owner        Staff?   @relation("WeeklyReportOwner", fields: [ownerStaffId], references: [id], onDelete: Cascade)
  /// The Monday the week starts on (IST calendar day); the week runs Monday to Sunday.
  weekStart    DateTime @db.Date
  content      Json
  createdAt    DateTime @default(now())

  @@unique([scopeKey, weekStart])
  @@index([ownerStaffId, weekStart])
}
