  grantedAt     DateTime?
  withdrawnAt   DateTime?
  withdrawnMethod       String?
  withdrawnByStaffId    String?
  withdrawnCallRecordId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([subjectType, subjectId, purpose, noticeVersion])
  @@index([subjectType, subjectId])
}

model BusinessAgreement {
