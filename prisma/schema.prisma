  ownerType             String    // referral, job_seeker, business
  ownerId               String
  ownerNameAtEntry      String
  method                String    // upi, bank
  maskedValue           String
  valueHash             String
  upiIdEncrypted        String?
  bankAccountEncrypted  String?
  ifsc                  String?
  verifiedName          String?
  nameMatches           Boolean?
  status                String    @default("pending_validation") // pending_validation, verified, flagged, superseded
  validatedAt           DateTime?
  activeFrom            DateTime
  changeOtpRequestId    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  payments              Payment[]

  @@index([ownerType, ownerId])
  @@index([valueHash])
  @@index([status])
}




