{
  "name": "laboura-field",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0 && tsc --noEmit",
    "test": "jest --ci",
    "build:web": "npm run build:web:field-path && npm run build:web:root",
    "build:web:field-path": "EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist && node scripts/pwa.js dist",
    "build:web:root": "LABOURA_FIELD_BASE_URL=/ EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist-root && node scripts/pwa.js dist-root /"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "0.4.1",
    "@expo-google-fonts/sora": "0.4.2",
    "@expo/metro-runtime": "58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.105.0",
    "expo": "58.0.21",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-location": "58.0.20",
    "expo-network": "58.0.4",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "fake-indexeddb": "6.2.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
