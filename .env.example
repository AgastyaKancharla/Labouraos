# Laboura settings. Copy to .env for local development.
# Every name here is the one name the code reads; render.yaml uses the same
# names. src/common/setting-names.spec.ts fails CI if they drift apart.

# Application
PORT=3000
NODE_ENV=development
# "web" for the API server, "worker" for the background job process.
# Only the worker runs scheduled jobs.
PROCESS_ROLE=web
# Public web address of the app, used in links sent by SMS and WhatsApp
# (invites, password resets, the public /p/... pages). Production:
# https://app.laboura.com. Links are never built from the visitor's own address.
PUBLIC_APP_URL="http://localhost:3000"
# The address that opens Laboura Field at its root (production: field.laboura.com).
# Empty: Laboura Field is only at /field. Comma-separated for more than one.
FIELD_HOST=""

# Database
# Locally both point at the same database. On Supabase (see DEPLOY.md):
#   DATABASE_URL = transaction pooler, port 6543, add
#                  ?pgbouncer=true&connection_limit=5&sslmode=require
#   DIRECT_URL   = session pooler, port 5432, add ?sslmode=require
#                  (used only by prisma migrate)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laboura_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/laboura_dev?schema=public"

# Job queue (Redis). On Render this is Render Key Value on the private
# network: plain connection (REDIS_TLS=false) and no password.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# On the web service only: /health/ready answers 503 when the worker's
# heartbeat is missing.
WORKER_HEARTBEAT_CHECK=false

# Authentication and encryption keys (each at least 32 characters)
JWT_SECRET="dev_secret_key_change_in_production_min_32_chars"
JWT_EXPIRES_IN="8h"
LOGIN_CODE_SECRET="dev_login_code_secret_change_in_production_32"
CALL_ROUTING_KEY="dev_call_routing_key_change_in_production_32ch"
PAYOUT_ACCOUNT_KEY="dev_payout_account_key_change_in_production_32"
STAFF_BOOTSTRAP_SECRET="dev_bootstrap_secret_change_in_production_32"
# Customer app sign-in (job seekers, businesses, referral partners): its own key,
# different from JWT_SECRET. Leave empty locally to derive a separate key from JWT_SECRET.
CUSTOMER_JWT_SECRET=""

# Reverse proxies in front of the app whose X-Forwarded-For entries are trusted
# (0 = ignore the header; client IP = socket address). Render: 1. Render behind
# Cloudflare: 2.
TRUST_PROXY_HOPS=0

# Uploaded files. "supabase" stores them in Supabase Storage; anything else
# keeps them in memory (lost on restart). Production refuses to start unless
# all four are "supabase".
CANDIDATE_PHOTO_STORAGE_MODE=mock
BUSINESS_PHOTO_STORAGE_MODE=mock
AGREEMENT_STORAGE_MODE=mock
RECORDING_STORAGE_MODE=mock
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket names. Leave unset to use these defaults.
CANDIDATE_PHOTOS_BUCKET=candidate-photos
BUSINESS_PHOTOS_BUCKET=business-photos
AGREEMENTS_BUCKET=agreements
RECORDINGS_BUCKET=recordings

# Company details printed on invoices and payment pages
COMPANY_LEGAL_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS="Bengaluru, Karnataka, India"
COMPANY_UPI_VPA=
COMPANY_UPI_PAYEE_NAME=

# Vendor modes (default: mock). One setting per vendor; AGENTS.md section 3.
OTP_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock
WHATSAPP_PROVIDER_MODE=mock
TELEPHONY_PROVIDER_MODE=mock
KYC_PROVIDER_MODE=mock
# Customer app pushes: mock logs them; real sends through Expo's push service.
CUSTOMER_PUSH_PROVIDER_MODE=mock

# Expo push access token (optional; only if enhanced push security is on in the Expo account)
EXPO_ACCESS_TOKEN=

# SMS and OTP gateway (when OTP_PROVIDER_MODE or SMS_PROVIDER_MODE is real)
SMS_API_KEY=
# OTP defaults to https://control.msg91.com/api/v5; plain SMS needs it set.
SMS_API_URL=
DLT_SENDER_ID="LABOUR"
DLT_TEMPLATE_ID=
DLT_ENTITY_ID=
# JSON object of message template name to DLT template id.
SMS_DLT_TEMPLATE_IDS=

# WhatsApp Business API, Meta Cloud API (when WHATSAPP_PROVIDER_MODE=real)
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Calling (when TELEPHONY_PROVIDER_MODE=real)
TELEPHONY_VENDOR="exotel-cloud-telephony"
TOLL_FREE_NUMBER=
TELEPHONY_CHANNELS="60"

# Aadhaar e-KYC through a licensed vendor (when KYC_PROVIDER_MODE=real)
KYC_API_KEY=
KYC_API_URL=
# Defaults to <KYC_API_URL>/health
KYC_HEALTH_URL=

# Card payments and payouts (when PAYMENT_PROVIDER_MODE=real)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX payout-status webhooks carry their own secret; if unset this falls
# back to RAZORPAY_WEBHOOK_SECRET.
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Webhook signing secrets (each at least 32 characters)
BANK_FEED_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
TELEPHONY_WEBHOOK_SECRET=
MESSAGE_WEBHOOK_SECRET=

# Alerts (Slack-style incoming webhook). Unset = alerts only go to the logs.
ALERT_WEBHOOK_URL=

# Cloudflare Access in front of the office web app's staff pages (/login, /ceo,
# /manager, /team-lead, /finance, /call-agent) and the old Admin Dashboard
# (/console/admin) only. When ENFORCED=true the app verifies the signed
# Cf-Access-Jwt-Assertion token (RS256 signature against the team's JWKS, plus
# audience, issuer and expiry); header presence alone is not accepted. With
# ENFORCED=true and either value below missing, the app refuses to start.
CLOUDFLARE_ACCESS_ENFORCED=false
# Your Zero Trust team domain, e.g. laboura.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# The Access application's AUD tag (Zero Trust dashboard > Access > Applications)
CLOUDFLARE_ACCESS_AUD=
