# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laboura_dev?schema=public"

# Authentication
JWT_SECRET="dev_secret_key_change_in_production_min_32_chars"
JWT_EXPIRES_IN="8h"

# Provider Modes (default: mock)
OTP_PROVIDER_MODE="mock"
PAYMENT_PROVIDER_MODE="mock"
TELEPHONY_PROVIDER_MODE="mock"
WHATSAPP_PROVIDER_MODE="mock"
KYC_PROVIDER_MODE="mock"

# DLT / SMS Vendor Configuration (when OTP_PROVIDER_MODE=real)
MSG91_AUTH_KEY=""
DLT_SENDER_ID="LABOUR"
DLT_TEMPLATE_ID=""
DLT_ENTITY_ID=""

# WhatsApp Business API Configuration (when WHATSAPP_PROVIDER_MODE=real)
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloud Telephony Configuration (when TELEPHONY_PROVIDER_MODE=real)
TELEPHONY_VENDOR="exotel-cloud-telephony"
TOLL_FREE_NUMBER="18001234567"
TELEPHONY_CHANNELS="60"

# Payment Gateway & Payout API (when PAYMENT_PROVIDER_MODE=real)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""

# Licensed OVSE Aadhaar e-KYC (when KYC_PROVIDER_MODE=real)
OVSE_KYC_API_KEY=""
OVSE_KYC_API_URL=""


# Reverse proxies in front of the app whose X-Forwarded-For entries are trusted
# (0 = ignore the header; client IP = socket address). Must match the real
# network path in each environment; verify by logging raw headers once deployed.
TRUST_PROXY_HOPS=0
